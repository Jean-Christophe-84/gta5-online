{% block javascripts %}
    <script type="text/javascript">
        {% if is_granted('HEIST_CASINO_EDIT') %}
            checkTemplate();
        {% endif %}

        function resetHeistCasino() {
            postRequest('{{ path('reset_casino_heist') }}')
            .then(response => response.json())
            .then(data => {
                showAlert(data.success, data.message);
                document.querySelector('div#loots').innerHTML = data.template;
                checkTemplate();
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function checkTemplate() {
            tippy(document.getElementById('resetHeistCasino'), {content: "{{ 'reset_the_heist'|translateLocale|mbUcfirst|e('js') }}"});

            new TomSelect("#firstTimeInWeek", { maxOptions: null });
            new TomSelect("#mainLootId", { maxOptions: null });
            new TomSelect("#difficulty", { maxOptions: null });
            new TomSelect("#approach", { maxOptions: null });
            new TomSelect("#hackerId", { maxOptions: null });
            new TomSelect("#driverId", { maxOptions: null });
            new TomSelect("#gunmanId", { maxOptions: null });

            document.querySelectorAll('.form_casino_heist[name]').forEach(function(input) {
                input.addEventListener('change', function() {
                    if (this.value == '') {
                        this.value = 0;
                    }
                    postRequest('{{ path('form_casino_heist') }}?place=' + this.getAttribute('name') + '&value=' + this.value)
                    .then(response => response.json())
                    .then(data => {
                        showAlert(data.success, data.message);
                        document.querySelector('div#loots').innerHTML = data.template;
                        checkTemplate();
                    })
                    .catch((error) => {
                        console.error(error);
                        showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                    })
                    .finally(() => {
                        hideLoader();
                    });
                })
            });
        }
    </script>
{% endblock %}
