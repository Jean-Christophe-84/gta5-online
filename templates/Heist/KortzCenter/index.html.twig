{% block javascripts %}
    <script type="text/javascript">
        {% if is_granted('HEIST_KORTZ_CENTER_EDIT') %}
            checkTemplate();
        {% endif %}

        function resetHeistKortzCenter() {
            postRequest('{{ path('reset_kortz_center_heist') }}')
            .then(response => response.json())
            .then(data => {
                showAlert(data.success, data.message);
                document.querySelector('div#loots').innerHTML = data.template;
                checkTemplate();
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function checkTemplate() {
            tippy(document.getElementById('resetHeistKortzCenter'), {content: "{{ 'reset_the_heist'|translateLocale|mbUcfirst|e('js') }}"});

            new TomSelect("#firstTimeInWeek", { maxOptions: null });
            new TomSelect("#difficulty", { maxOptions: null });
            new TomSelect("#material", { maxOptions: null });
            new TomSelect("#weapon", { maxOptions: null });
            new TomSelect("#vehicle", { maxOptions: null });
            new TomSelect("#mainLoot", { maxOptions: null });

            {% for heistKortzCenterSecondaryLoot in heistKortzCenterSecondaryLoots|sort((firstLoot, secondLoot) => firstLoot.id <=> secondLoot.id) %}
                {% set heistKortzCenterSecondaryLootNameIds = [] %}
                {% if heistKortzCenterSecondaryLoot.heistKortzCenterSecondaryLootNameIds is not null %}
                    {% set heistKortzCenterSecondaryLootNameIds = heistKortzCenterSecondaryLoot.heistKortzCenterSecondaryLootNameIds|split('+') %}
                {% endif %}
                {% if heistKortzCenterSecondaryLootNameIds|length > 1 %}
                    new TomSelect("#heistKortzCenterSecondaryLootNameId_{{ heistKortzCenterSecondaryLoot.id }}", { maxOptions: null });
                {% endif %}
            {% endfor %}

            document.querySelectorAll('.form_kortz_center_heist[name]').forEach(function(input) {
                input.addEventListener('change', function() {
                    showLoader();

                    postRequest('{{ path('form_kortz_center_heist') }}?place=' + this.getAttribute('name') + '&value=' + this.value)
                    .then(response => response.json())
                    .then(data => {
                        showAlert(data.success, data.message);
                        document.querySelector('div#loots').innerHTML = data.template;
                        checkTemplate();
                    })
                    .catch((error) => {
                        console.error(error);
                        showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                    })
                    .finally(() => {
                        hideLoader();
                    });
                })
            });

            document.querySelectorAll('.form_secondary_loot_kortz_center_heist[data-type]').forEach(function(input) {
                input.addEventListener('change', function() {
                    showLoader();

                    let value;

                    if (this.getAttribute('data-type') == 'active' || this.getAttribute('data-type') == 'buyer_request') {
                        value = this.checked ? 1 : 0;
                    } else {
                        value = this.value;
                    }

                    postRequest('{{ path('form_secondary_loot_kortz_center_heist') }}'
                        + '?type=' + this.getAttribute('data-type')
                        + '&value=' + value
                        + '&id=' + this.getAttribute('data-id')
                    )
                    .then(response => response.json())
                    .then(data => {
                        showAlert(data.success, data.message);
                        document.querySelector('div#loots').innerHTML = data.template;
                        checkTemplate();
                    })
                    .catch((error) => {
                        console.error(error);
                        showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                    })
                    .finally(() => {
                        hideLoader();
                    });
                })
            });
        }
    </script>
{% endblock %}
