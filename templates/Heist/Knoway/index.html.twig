{% extends "layout.html.twig" %}

{% block title %}KnoWay - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content guide">
        {{ include('_partial/alert.html.twig') }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
        </div>
        <h3>KnoWay</h3>
        <div class="tables">
            <table>
                <tbody>
                    <tr>
                        <th colspan="3">
                            KnoWay Out
                            <br/>
                            {{ 'contact_avi_schwartzman'|translateLocale|mbUcfirst }}
                            <br/>
                            1 - 4 {{ 'players'|translateLocale|mbUcfirst }}
                        </th>
                    </tr>
                    <tr>
                        <th colspan="3">{{ 'missions'|translateLocale|mbUcfirst }}</th>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align: center;">{{ 'negative_press'|translateLocale|mbUcfirst }}</td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align: center;">{{ 'an_internal_matter'|translateLocale|mbUcfirst }}</td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align: center;">{{ 'tunnel_vision'|translateLocale|mbUcfirst }}</td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align: center;">{{ 'verbal_provocations'|translateLocale|mbUcfirst }}</td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align: center;">{{ 'a_new_beginning'|translateLocale|mbUcfirst }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'difficulty'|translateLocale|mbUcfirst }}</th>
                        <th>{{ 'earnings_of_the_first_heist_of_the_week'|translateLocale|mbUcfirst }} ({{ 'from_thursday_at_12_00_p_m_to_the_following_thursday_at_12_00_p_m'|translateLocale|mbUcfirst }})</th>
                        <th>{{ 'earnings_of_the_other_heists_throughout_the_week'|translateLocale|mbUcfirst }} ({{ 'from_thursday_at_12_00_p_m_to_the_following_thursday_at_12_00_p_m'|translateLocale|mbUcfirst }})</th>
                    </tr>
                    <tr>
                        <td>{{ 'normal'|translateLocale({gender: 'feminine'})|mbUcfirst }}</td>
                        <td>{{ 455700|formatMoney }}</td>
                        <td>{{ 245000|formatMoney }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'hard'|translateLocale|mbUcfirst }}</td>
                        <td>{{ 683550|formatMoney }}</td>
                        <td>{{ 367500|formatMoney }}</td>
                    </tr>
                    <tr>
                        <th colspan="3">{{ 'elite_challenge'|translateLocale|mbUcfirst }}</th>
                    </tr>
                    <tr>
                        <th>{{ 'loot'|translateLocale|mbUcfirst }}</th>
                        <th>{{ 'difficulty'|translateLocale|mbUcfirst }}</th>
                        <th>{{ 'conditions'|translateLocale|mbUcfirst }}</th>
                    </tr>
                    <tr>
                        <td>{{ 50000|formatMoney }}</td>
                        <td>{{ 'normal'|translateLocale({gender: 'feminine'})|mbUcfirst }}</td>
                        <td rowspan="2">{{ 'finish_the_heist_in_less_than'|translateLocale|mbUcfirst }} 10 min / {{ 'no_player_dies'|translateLocale|mbUcfirst }} / {{ 'no_failed_hacking'|translateLocale|mbUcfirst }} / {{ 'at_least_35_headshots_in_total'|translateLocale|mbUcfirst }} / {{ 'no_quick_restart'|translateLocale|mbUcfirst }}</td>
                    </tr>
                    <tr>
                        <td>{{ 100000|formatMoney }}</td>
                        <td>{{ 'hard'|translateLocale|mbUcfirst }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
