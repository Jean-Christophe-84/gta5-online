<div class="group">
    <div class="form-group" style="--filter-width: 40%;">
        <label class="form-label required" for="name">{{ 'name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="name" id="name" class="form-input"
            {% if vehicleAcquisition and vehicleAcquisition.name %} value="{{ vehicleAcquisition.name }}"{% endif %} />
        <div class="error" id="error_name">{{ 'please_enter_the_name'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 20%;">
        <label class="form-label" for="acquirable">{{ 'acquirable'|translateLocale|mbUcfirst }}</label>
        <div class="checkbox-wrapper-2">
            <input type="checkbox" name="acquirable" id="acquirable" value="1"
                   {% if not vehicleAcquisition or vehicleAcquisition.acquirable %} checked{% endif %} class="stylized" />
        </div>
    </div>
    <div class="form-group" style="--filter-width: 20%;">
        <label class="form-label" for="available">{{ 'available'|translateLocale|mbUcfirst }}</label>
        <div class="checkbox-wrapper-2">
            <input type="checkbox" name="available" id="available" value="1"
                   {% if not vehicleAcquisition or vehicleAcquisition.available %} checked{% endif %} class="stylized" />
        </div>
    </div>
    <div class="form-group" style="--filter-width: 20%;">
        <label class="form-label" for="promotion">{{ 'promotion'|translateLocale|mbUcfirst }}</label>
        <div class="checkbox-wrapper-2">
            <input type="checkbox" name="promotion" id="promotion" value="1"{% if vehicleAcquisition and vehicleAcquisition.promotion %} checked{% endif %} class="stylized" />
        </div>
    </div>
    <input type="hidden" name="id" value="{{ vehicleAcquisition ? vehicleAcquisition.id : '' }}">
</div>
