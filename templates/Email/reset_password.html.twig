{% extends 'Email/_layout.html.twig' %}

{% block title %}{{ 'reset_password_mail_subject'|translateLocale({}, locale)|mbUcfirst }}{% endblock %}

{% block content %}
    <p style="margin:0 0 16px;">{{ 'you_made_a_password_reset_request'|translateLocale({}, locale)|mbUcfirst }}.</p>
    <p style="margin:0 0 16px;">{{ 'if_you_are_not_at_the_origin_of_this_request_contact_the_website_administrator'|translateLocale({}, locale)|mbUcfirst }}.</p>
    <p style="margin:0;">{{ 'in_the_opposite_case_click_on_the_link_below'|translateLocale({}, locale)|mbUcfirst }}.</p>
{% endblock %}

{% block button %}
    {{ include('Email/_button.html.twig', {label: 'i_reset_my_password'|translateLocale({}, locale)|mbUcfirst}) }}
{% endblock %}
