{% extends "layout.html.twig" %}

{% block title %}{{ 'weapons'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content">
        {{ include('_partial/alert.html.twig') }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a onclick="launchCommandWeapon();" class="btn btn-success{% if not configuration.percentageVehicles and not configuration.percentageProperties and not configuration.percentageWeapons and not configuration.percentagePromotions %} is-visible{% endif %}" id="launchCommandWeapon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M73.4 182.6C60.9 170.1 60.9 149.8 73.4 137.3C85.9 124.8 106.2 124.8 118.7 137.3L278.7 297.3C291.2 309.8 291.2 330.1 278.7 342.6L118.7 502.6C106.2 515.1 85.9 515.1 73.4 502.6C60.9 490.1 60.9 469.8 73.4 457.3L210.7 320L73.4 182.6zM288 448L544 448C561.7 448 576 462.3 576 480C576 497.7 561.7 512 544 512L288 512C270.3 512 256 497.7 256 480C256 462.3 270.3 448 288 448z" />
                    </svg>
                </a>
                <a onclick="stopCommandWeapon();" class="btn btn-danger{% if configuration.percentageWeapons %} is-visible{% endif %}" id="stopCommandWeapon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 96C352 78.3 337.7 64 320 64C302.3 64 288 78.3 288 96L288 304C288 312.8 280.8 320 272 320C263.2 320 256 312.8 256 304L256 128C256 110.3 241.7 96 224 96C206.3 96 192 110.3 192 128L192 400C192 401.5 192 403.1 192.1 404.6L131.6 347C115.6 331.8 90.3 332.4 75 348.4C59.7 364.4 60.4 389.7 76.4 405L188.8 512C231.9 553.1 289.2 576 348.8 576L368 576C465.2 576 544 497.2 544 400L544 192C544 174.3 529.7 160 512 160C494.3 160 480 174.3 480 192L480 304C480 312.8 472.8 320 464 320C455.2 320 448 312.8 448 304L448 128C448 110.3 433.7 96 416 96C398.3 96 384 110.3 384 128L384 304C384 312.8 376.8 320 368 320C359.2 320 352 312.8 352 304L352 96z" />
                    </svg>
                </a>
                <div id="configuration-loader-weapon" class="configuration-loader{% if configuration.percentageWeapons %} is-visible{% endif %}" role="status" aria-live="polite">
                    <div class="configuration-loader__spinner" aria-hidden="true"></div>
                    <div id="configuration-loader-weapon__text" class="configuration-loader__text">{{ configuration.percentageWeapons|formatPercent(2, true) }}</div>
                </div>
            {% endif %}
        </div>
        <div class="include filters">
            {{ include('Weapon/_partial/filter.html.twig') }}
        </div>
        {% if is_granted('WEAPON_ADD') %}
            <div class="addWeapon" id="addWeapon">
                <button class="btn btn-primary" data-modal-open="#weaponModal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                    </svg>
                </button>
            </div>
        {% endif %}
        <div class="include filters filters_two">
            {{ include('Weapon/_partial/filter_two.html.twig') }}
        </div>
        {% if is_granted('WEAPON_OWN') %}
            <div class="include summary">
                {{ include('_partial/summary.html.twig', {entity: 'weapons'}) }}
            </div>
        {% endif %}
        <div class="table-scroll weapons">
            {{ include('Weapon/_partial/template.html.twig') }}
        </div>
        <div class="modal" id="weaponModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="weaponModalTitle">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="weaponModalTitle"></h2>
                        <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer">
                        <div class="submit">
                            <button class="btn btn-success" onclick="formWeapon();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                            {% if is_granted('WEAPON_DELETE') %}
                                <button class="btn btn-danger" data-delete-confirm onclick="deleteWeapon();">{{ 'confirm'|translateLocale|mbUcfirst }}</button>
                            {% endif %}
                            <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('returnMenu'), {content: "{{ 'return_to_main_menu'|translateLocale|mbUcfirst|e('js') }}"});
        {% if is_granted('ROLE_ADMIN') %}
            tippy(document.getElementById('launchCommandWeapon'), {content: "{{ 'launch_the_weapons_retrieval_command'|translateLocale|mbUcfirst|e('js') }}"});
            tippy(document.getElementById('stopCommandWeapon'), {content: "{{ 'stop_the_weapons_retrieval_command'|translateLocale|mbUcfirst|e('js') }}"});
        {% endif %}
        tippy(document.getElementById('addWeapon'), {content: "{{ 'add_a_weapon'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('removeAllFilters'), {content: "{{ 'remove_all_filters'|translateLocale|mbUcfirst|e('js') }}"});

        let filterWeaponManufacturerId;
        let filterTitleUpdateId;
        let filterOwned;
        let filterWeaponTwo;
        let filterEvolution;
        let filterWeaponClassIds;
        let filterWeaponAcquisitionIds;
        let filterSearch;
        let filterNotWeaponClassIds;
        let filterNotWeaponAcquisitionIds;
        let filterNotStorageLocationIds;
        let reloadTimerId;

        {% if is_granted('ROLE_ADMIN') %}
            if (document.getElementById('configuration-loader-weapon').classList.contains('is-visible')) {
                checkCommandWeapon();
            }
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            function checkCommandWeapon() {
                fetch('{{ path('check_command_weapon') }}')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        showAlert(false, data.message, data.error);
                    } else {
                        if (data.percentage !== "0") {
                            document.querySelector('div.table-scroll.weapons').style.marginTop = '40px';
                            document.getElementById('launchCommandWeapon').classList.remove('is-visible');
                            document.getElementById('configuration-loader-weapon').classList.add('is-visible');
                            document.getElementById('stopCommandWeapon').classList.add('is-visible');
                            document.getElementById('configuration-loader-weapon__text').textContent = data.percentageFormatted;

                            setTimeout("checkCommandWeapon();", 5000);
                        } else {
                            document.querySelector('div.table-scroll.weapons').style.marginTop = '15px';
                            document.getElementById('stopCommandWeapon').classList.remove('is-visible');
                            document.getElementById('configuration-loader-weapon').classList.remove('is-visible');
                            document.getElementById('launchCommandWeapon').classList.add('is-visible');
                        }
                    }
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                });
            }

            function launchCommandWeapon() {
                showLoader();

                postRequest('{{ path('launch_command_weapon') }}')
                .then(response => response.json())
                .then(data => {
                    showAlert(data.success, data.message);
                    checkCommandWeapon();
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }

            function stopCommandWeapon() {
                showLoader();

                postRequest('{{ path('stop_command_weapon') }}')
                .then(response => response.json())
                .then(data => {
                    showAlert(data.success, data.message);
                    checkCommandWeapon();
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        function removeAllFilters() {
            showLoader();

            fetch('{{ path('filter_weapon') }}'
                + '?weaponManufacturerId=0'
                + '&titleUpdateId=0'
                + '&owned=null'
                + '&weaponTwo=0'
                + '&evolution=0'
                + '&search='
                + '&page=' + {{ filter['page'] }}
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkWeapons(data.weapons);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function reloadFilter(urlOrder = '', page = null) {
            showLoader();

            let urlWeaponClassIds          = '';
            let urlWeaponAcquisitionIds    = '';
            let urlNotWeaponClassIds       = '';
            let urlNotWeaponAcquisitionIds = '';
            let urlPage                    = (page !== null) ? '&page=' + page : '&page=' + {{ filter['page'] }};

            if (filterWeaponClassIds) {
                filterWeaponClassIds.tomselect.items.forEach(weaponClassId => {
                    urlWeaponClassIds += '&weaponClassIds[]=' + weaponClassId;
                });
            }

            if (filterWeaponAcquisitionIds) {
                filterWeaponAcquisitionIds.tomselect.items.forEach(weaponAcquisitionId => {
                    urlWeaponAcquisitionIds += '&weaponAcquisitionIds[]=' + weaponAcquisitionId;
                });
            }

            if (filterNotWeaponClassIds) {
                filterNotWeaponClassIds.tomselect.items.forEach(notWeaponClassId => {
                    urlNotWeaponClassIds += '&notWeaponClassIds[]=' + notWeaponClassId;
                });
            }

            if (filterNotWeaponAcquisitionIds) {
                filterNotWeaponAcquisitionIds.tomselect.items.forEach(notWeaponAcquisitionId => {
                    urlNotWeaponAcquisitionIds += '&notWeaponAcquisitionIds[]=' + notWeaponAcquisitionId;
                });
            }

            fetch('{{ path('filter_weapon') }}'
                + '?weaponManufacturerId=' + filterWeaponManufacturerId.value
                + '&titleUpdateId=' + filterTitleUpdateId.value
                + '&owned=' + filterOwned.value
                + '&weaponTwo=' + filterWeaponTwo.value
                + '&evolution=' + filterEvolution.value
                + urlWeaponClassIds
                + urlWeaponAcquisitionIds
                + '&search=' + filterSearch.value
                + urlNotWeaponClassIds
                + urlNotWeaponAcquisitionIds
                + urlPage
                + urlOrder
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkWeapons(data.weapons);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        checkFilter();
        checkWeapons({{ weapons|json_encode|raw }});

        function checkFilter() {
            filterWeaponManufacturerId    = document.getElementById('filterWeaponManufacturerId');
            filterTitleUpdateId           = document.getElementById('filterTitleUpdateId');
            filterOwned                   = document.getElementById('filterOwned');
            filterWeaponTwo               = document.getElementById('filterWeaponTwo');
            filterEvolution               = document.getElementById('filterEvolution');
            filterWeaponClassIds          = document.getElementById('filterWeaponClassIds');
            filterWeaponAcquisitionIds    = document.getElementById('filterWeaponAcquisitionIds');
            filterSearch                  = document.getElementById('filterSearch');
            filterNotWeaponClassIds       = document.getElementById('filterNotWeaponClassIds');
            filterNotWeaponAcquisitionIds = document.getElementById('filterNotWeaponAcquisitionIds');

            new TomSelect("#filterWeaponManufacturerId", { maxOptions: null });
            new TomSelect("#filterTitleUpdateId", { maxOptions: null });
            {% if is_granted('WEAPON_OWN') %}
                new TomSelect("#filterOwned", { maxOptions: null });
            {% endif %}
            new TomSelect("#filterWeaponTwo", { maxOptions: null });
            new TomSelect("#filterEvolution", { maxOptions: null });
            new TomSelect("#filterWeaponClassIds", { maxOptions: null, plugins: ['remove_button'] });
            new TomSelect("#filterWeaponAcquisitionIds", { maxOptions: null, plugins: ['remove_button'] });
            new TomSelect("#filterNotWeaponClassIds", { maxOptions: null, plugins: ['remove_button'] });
            new TomSelect("#filterNotWeaponAcquisitionIds", { maxOptions: null, plugins: ['remove_button'] });

            filterWeaponManufacturerId.addEventListener('change', () => {
                reloadFilter();
            });
            filterTitleUpdateId.addEventListener('change', () => {
                reloadFilter();
            });
            {% if is_granted('WEAPON_OWN') %}
                filterOwned.addEventListener('change', () => {
                    reloadFilter();
                });
            {% endif %}
            filterWeaponTwo.addEventListener('change', () => {
                reloadFilter();
            });
            filterEvolution.addEventListener('change', () => {
                reloadFilter();
            });
            filterWeaponClassIds.addEventListener('change', () => {
                reloadFilter();
            });
            filterWeaponAcquisitionIds.addEventListener('change', () => {
                reloadFilter();
            });
            filterSearch.addEventListener("input", () => {
                clearTimeout(reloadTimerId);
                reloadTimerId = setTimeout(() => {
                    reloadFilter();
                }, 500);
            });
            filterNotWeaponClassIds.addEventListener('change', () => {
                reloadFilter();
            });
            filterNotWeaponAcquisitionIds.addEventListener('change', () => {
                reloadFilter();
            });
        }

        function checkWeapons(weapons) {
            weapons.forEach(weapon => {
                let content = '';

                if (weapon.realLifeWeapon) {
                    content += '{{ 'real_name'|translateLocale|mbUcfirst|colon|e('js') }} ' + escapeHtml(weapon.realLifeWeapon);
                }

                if (weapon.webPath) {
                    content += '<br/><img src="' + escapeHtml(weapon.webPath) + '" alt="' + escapeHtml(weapon.name) + '" class="img-fluid" style="height: 154px; margin-top: 10px; width: 274px;" />';
                }

                tippy(document.getElementById('weaponName_' + weapon.id), {content: content, allowHTML: true});
                tippy(document.getElementById('formWeapon_' + weapon.id), {content: '{{ 'edit_the_weapon'|translateLocale|mbUcfirst|e('js') }} "' + weapon.name + '"'});
                {% if is_granted('WEAPON_DELETE') %}
                    tippy(document.getElementById('deleteWeapon_' + weapon.id), {content: '{{ 'delete_the_weapon'|translateLocale|mbUcfirst|e('js') }} "' + weapon.name + '"'});
                {% endif %}

                if (weapon.comment || weapon.unlockWeapon) {
                    let infoContent = '';

                    if (weapon.comment) {
                        infoContent += '<strong>{{ 'comment'|translateLocale|mbUcfirst|colon|e('js') }} </strong><br/>' + escapeHtml(weapon.comment).replace(/\r?\n/g, '<br/>');
                    }

                    if (weapon.unlockWeapon) {
                        if (weapon.comment) {
                            infoContent += '<br/><br/>';
                        }

                        infoContent += '<strong>{{ 'unlock'|translateLocale|mbUcfirst|colon|e('js') }} </strong><br/>' + escapeHtml(weapon.unlockWeapon).replace(/\r?\n/g, '<br/>');
                    }

                    tippy(document.getElementById('svgInfo_' + weapon.id), {content: infoContent, allowHTML: true});
                }

                if (weapon.weaponOneNames) {
                    let weaponOneNames = weapon.weaponOneNames ? weapon.weaponOneNames.split('+') : [];
                    let parentContent   = '<strong>{{ 'parents'|translateLocale|mbUcfirst|colon|e('js') }} </strong><br/>' + weaponOneNames.map(weaponOneName => escapeHtml(weaponOneName)).join('<br/>');

                    tippy(document.getElementById('svgParent_' + weapon.id), {content: parentContent, allowHTML: true});
                }

                tippy(document.getElementById('svgEvolution_' + weapon.id), {content: "{{ 'evolution_of_another_weapon'|translateLocale|mbUcfirst|e('js') }}", allowHTML: true});
            });
        }

        function editWeapon(weaponId) {
            showLoader();

            let owned = document.getElementById('weaponOwned_' + weaponId);

            postRequest('{{ path('update_weapon') }}?weaponId=' + weaponId + '&owned=' + (owned.checked ? 1 : 0))
            .then(response => response.json())
            .then(data => {
                if (data.success === true) {
                    refreshList(data);
                    checkFilter();
                    checkWeapons(data.weapons);
                }
                showAlert(data.success, data.message);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function formWeapon() {
            showLoader();

            let name                 = document.querySelector('#weaponModal').querySelector('input[name="name"]');
            let weaponManufacturerId = document.querySelector('#weaponModal').querySelector('select[name="weaponManufacturerId"]');
            let owned                = document.querySelector('#weaponModal').querySelector('input[name="owned"]');
            let evolution            = document.querySelector('#weaponModal').querySelector('input[name="evolution"]');
            let weaponOneIds         = document.querySelector('#weaponModal').querySelector('select[name="weaponOneIds[]"]');
            let weaponClassIds       = document.querySelector('#weaponModal').querySelector('select[name="weaponClassIds[]"]');
            let titleUpdateId        = document.querySelector('#weaponModal').querySelector('select[name="titleUpdateId"]');
            let price                = document.querySelector('#weaponModal').querySelector('input[name="price"]');
            let discountedPrice      = document.querySelector('#weaponModal').querySelector('input[name="discountedPrice"]');
            let discountedPercentage = document.querySelector('#weaponModal').querySelector('input[name="discountedPercentage"]');
            let damage               = document.querySelector('#weaponModal').querySelector('input[name="damage"]');
            let fireRate             = document.querySelector('#weaponModal').querySelector('input[name="fireRate"]');
            let accuracy             = document.querySelector('#weaponModal').querySelector('input[name="accuracy"]');
            let rangeWeapon          = document.querySelector('#weaponModal').querySelector('input[name="rangeWeapon"]');
            let clipSize             = document.querySelector('#weaponModal').querySelector('input[name="clipSize"]');
            let realLifeWeapon       = document.querySelector('#weaponModal').querySelector('input[name="realLifeWeapon"]');
            let url                  = document.querySelector('#weaponModal').querySelector('input[name="url"]');
            let weaponAcquisitionIds = document.querySelector('#weaponModal').querySelector('select[name="weaponAcquisitionIds[]"]');
            let customizationIds     = document.querySelector('#weaponModal').querySelector('select[name="customizationIds[]"]');
            let unlockRank           = document.querySelector('#weaponModal').querySelector('input[name="unlockRank"]');
            let comment              = document.querySelector('#weaponModal').querySelector('textarea[name="comment"]');
            let unlockWeapon         = document.querySelector('#weaponModal').querySelector('textarea[name="unlockWeapon"]');
            let weaponId             = document.querySelector('#weaponModal').querySelector('input[name="id"]');

            document.querySelector('#weaponModal').querySelector('#error_name').classList.remove('show');

            if (!name.value) {
                document.querySelector('#weaponModal').querySelector('#error_name').classList.add('show');

                hideLoader();
            } else {
                let urlWeaponOneIds         = '';
                let urlWeaponClassIds       = '';
                let urlWeaponAcquisitionIds = '';
                let urlCustomizationIds     = '';

                if (weaponOneIds) {
                    weaponOneIds.tomselect.items.forEach(weaponOneId => {
                        urlWeaponOneIds += '&weaponOneIds[]=' + weaponOneId;
                    });
                }

                if (weaponClassIds) {
                    weaponClassIds.tomselect.items.forEach(weaponClassId => {
                        urlWeaponClassIds += '&weaponClassIds[]=' + weaponClassId;
                    });
                }

                if (weaponAcquisitionIds) {
                    weaponAcquisitionIds.tomselect.items.forEach(weaponAcquisitionId => {
                        urlWeaponAcquisitionIds += '&weaponAcquisitionIds[]=' + weaponAcquisitionId;
                    });
                }

                if (customizationIds) {
                    customizationIds.tomselect.items.forEach(customizationId => {
                        urlCustomizationIds += '&customizationIds[]=' + customizationId;
                    });
                }

                postRequest('{{ path('form_weapon') }}'
                    + '?name=' + encodeURIComponent(name.value)
                    + '&weaponManufacturerId=' + weaponManufacturerId.value
                    + '&owned=' + (owned.checked ? 1 : 0)
                    + '&evolution=' + (evolution.checked ? 1 : 0)
                    + urlWeaponOneIds
                    + urlWeaponClassIds
                    + '&titleUpdateId=' + titleUpdateId.value
                    + '&price=' + price.value
                    + '&discountedPrice=' + discountedPrice.value
                    + '&discountedPercentage=' + discountedPercentage.value
                    + '&damage=' + damage.value
                    + '&fireRate=' + fireRate.value
                    + '&accuracy=' + accuracy.value
                    + '&rangeWeapon=' + rangeWeapon.value
                    + '&clipSize=' + clipSize.value
                    + '&realLifeWeapon=' + realLifeWeapon.value
                    + '&url=' + (url ? url.value : '')
                    + urlWeaponAcquisitionIds
                    + urlCustomizationIds
                    + '&unlockRank=' + unlockRank.value
                    + '&comment=' + encodeURIComponent(comment.value)
                    + '&unlockWeapon=' + encodeURIComponent(unlockWeapon.value)
                    + '&weaponId=' + weaponId.value
                )
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#weaponModal'));
                        refreshList(data);
                        checkFilter();
                        checkWeapons(data.weapons);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        }

        {% if is_granted('WEAPON_DELETE') %}
            function deleteWeapon() {
                showLoader();

                postRequest('{{ path('delete_weapon') }}?weaponId=' + document.querySelector('#weaponModal').querySelector('input[name="id"]').value)
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#weaponModal'));
                        refreshList(data);
                        checkFilter();
                        checkWeapons(data.weapons);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        document.addEventListener("click", (event) => {
            const opener = event.target.closest("[data-modal-open]");

            if (!opener) return;

            showLoader();

            const id         = opener.getAttribute("data-weapon-id") ?? '';
            const modal      = document.querySelector(opener.getAttribute("data-modal-open"));
            const deleteMode = opener.hasAttribute("data-delete");

            openModal(modal);

            if (deleteMode) {
                modal.querySelector('#weaponModalTitle').textContent = '{{ 'delete_the_weapon'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-weapon-name") + '"';
            } else if (id) {
                modal.querySelector('#weaponModalTitle').textContent = '{{ 'edit_the_weapon'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-weapon-name") + '"';
            } else {
                modal.querySelector('#weaponModalTitle').textContent = '{{ 'add_a_weapon'|translateLocale|mbUcfirst|e('js') }}';
            }

            fetch('{{ path('get_weapon') }}?weaponId=' + id + (deleteMode ? '&delete=1' : ''))
            .then(response => response.json())
            .then(data => {
                modal.querySelector('.modal-body').innerHTML = data.template;
                new TomSelect("#weaponManufacturerId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#weaponOneIds", { maxOptions: null, plugins: ['remove_button'] });
                new TomSelect("#weaponClassIds", { maxOptions: null, plugins: ['remove_button'] });
                new TomSelect("#titleUpdateId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#weaponAcquisitionIds", { maxOptions: null, plugins: ['remove_button'] });
                new TomSelect("#customizationIds", { maxOptions: null, plugins: ['remove_button'] });
                setDeleteMode(modal, deleteMode, data.deletable);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        });
    </script>
{% endblock %}
