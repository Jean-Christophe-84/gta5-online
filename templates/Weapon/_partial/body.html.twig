</div>
<div class="group">
    <div class="form-group" style="--filter-width: 50%;">
        <label class="form-label" for="comment">{{ 'comment'|translateLocale|mbUcfirst }}</label>
        <textarea name="comment" id="comment" class="form-textarea" rows="10">{{ weapon ? weapon.comment : '' }}</textarea>
    </div>
    <div class="form-group" style="--filter-width: 50%;">
        <label class="form-label" for="unlockWeapon">{{ 'unlock'|translateLocale|mbUcfirst }}</label>
        <textarea name="unlockWeapon" id="unlockWeapon" class="form-textarea" rows="10">{{ weapon ? weapon.unlockWeapon : '' }}</textarea>
    </div>
    <input type="hidden" name="id" value="{{ weapon ? weapon.id : '' }}" />
</div>
