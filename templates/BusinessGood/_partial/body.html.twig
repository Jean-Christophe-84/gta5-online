               class="form-input" min="0" step="1" />
    </div>
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 100%;">
        <hr/>
    </div>
    <input type="hidden" name="id" value="{{ businessGood ? businessGood.id : '' }}" />
</div>
