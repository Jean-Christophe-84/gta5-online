               {% if businessGood and businessGood.timeForRestockWithUpgradedEquipment %} value="{{ businessGood.timeForRestockWithUpgradedEquipment }}"{% endif %}
               class="form-input" min="0" step="1" />
    </div>
    <div class="form-group" style="--filter-width: 35%;">
        <label class="form-label" for="timeForRestockWithUpgradedStaff">
            {{ 'time_for_restock_with'|translateLocale|mbUcfirst }} "{{ 'upgraded_staff_or_boost'|translateLocale }}" ({{ 'in_real_minutes'|translateLocale }})
        </label>
        <input type="number" name="timeForRestockWithUpgradedStaff" id="timeForRestockWithUpgradedStaff"
               {% if businessGood and businessGood.timeForRestockWithUpgradedStaff %} value="{{ businessGood.timeForRestockWithUpgradedStaff }}"{% endif %}
               class="form-input" min="0" step="1" />
    </div>
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 100%;">
        <label class="form-label" for="timeForRestockWithUpgradedEquipmentAndStaff">
            {{ 'time_for_restock_with_upgraded_equipment_and'|translateLocale|mbUcfirst }} "{{ 'upgraded_staff_or_boost'|translateLocale }}" ({{ 'in_real_minutes'|translateLocale }})
        </label>
        <input type="number" name="timeForRestockWithUpgradedEquipmentAndStaff" id="timeForRestockWithUpgradedEquipmentAndStaff"
