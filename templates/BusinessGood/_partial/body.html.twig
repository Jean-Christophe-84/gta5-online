    </div>
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 100%;">
        <label class="form-label" for="saleWithUpgradedEquipmentAndStaff">
            {{ 'sale_with_upgraded_equipment_and'|translateLocale|mbUcfirst }} "{{ 'upgraded_staff_or_boost'|translateLocale }}" ({{ 'in'|translateLocale ~ ' $)' }}
        </label>
        <input type="number" name="saleWithUpgradedEquipmentAndStaff" id="saleWithUpgradedEquipmentAndStaff"
               {% if businessGood and businessGood.saleWithUpgradedEquipmentAndStaff %} value="{{ businessGood.saleWithUpgradedEquipmentAndStaff }}"{% endif %}
               class="form-input" min="0" step="1" />
    </div>
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 100%;">
        <hr/>
    </div>
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 30%;">
        <label class="form-label" for="timeForRestock">
            {{ 'time_for_restock'|translateLocale|mbUcfirst }} ({{ 'in_real_minutes'|translateLocale }})
        </label>
        <input type="number" name="timeForRestock" id="timeForRestock"
               {% if businessGood and businessGood.timeForRestock %} value="{{ businessGood.timeForRestock }}"{% endif %} class="form-input" min="0" step="1" />
    </div>
    <div class="form-group" style="--filter-width: 35%;">
        <label class="form-label" for="timeForRestockWithUpgradedEquipment">
