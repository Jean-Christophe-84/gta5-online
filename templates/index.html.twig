                {% for tile in tiles|sortTiles %}
                    {{ tile.html }}
                {% endfor %}
            </div>

            <div class="modal modal--auto-height" id="promotionModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="promotionModalTitle">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title" id="promotionModalTitle">{{ 'command_promotion_remove_all'|translateLocale|mbUcfirst }}</h2>
                            <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                        </div>
                        <div class="modal-body modal-body--centered">
                            {{ 'command_promotion_remove_all_question'|translateLocale|mbUcfirst }}
                        </div>
                        <div class="modal-footer">
                            <div class="submit">
                                <button class="btn btn-success" onclick="launchCommandPromotion();">{{ 'confirm'|translateLocale|mbUcfirst }}</button>
                                <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block footer %}
    {{ include('_partial/footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('careerProgress'), {content: "{{ 'career_progress_description'|translateLocale|mbUcfirst|e('js') }}"});
        document.querySelectorAll('.promotion-badge').forEach(badge => {
            tippy(badge, {allowHTML: true, arrow: false, content: badge.querySelector('template').innerHTML, maxWidth: 340, theme: 'tips promotion'});
        });
        document.querySelectorAll('.tips-badge').forEach(badge => {
            tippy(badge, {allowHTML: true, arrow: false, content: badge.querySelector('template').innerHTML, maxWidth: 340, theme: 'tips', trigger: 'click'});

            badge.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
            });
        });
        tippy(document.getElementById('interactiveMap'), {content: "{{ 'interactive_map_description'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('newsSite'), {content: "{{ 'news_site_description'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('weeklyBonuses'), {content: "{{ 'weekly_bonuses_description'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('logout'), {content: "{{ 'logout'|translateLocale|mbUcfirst|e('js') }}"});
        {% if is_granted('ROLE_ADMIN') %}
            tippy(document.getElementById('launchCommandPromotion'), {content: "{{ 'command_promotion_launch'|translateLocale|mbUcfirst|e('js') }}"});
            tippy(document.getElementById('stopCommandPromotion'), {content: "{{ 'command_promotion_stop'|translateLocale|mbUcfirst|e('js') }}"});
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            if (document.getElementById('configuration-loader-promotion').classList.contains('is-visible')) {
                checkCommandPromotion();
            }
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            function checkCommandPromotion() {
                fetch('{{ path('check_command_promotion') }}')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        showAlert(false, data.message, data.error);
                    } else {
                        if (data.percentage !== "0") {
                            document.getElementById('launchCommandPromotion').classList.remove('is-visible');
                            document.getElementById('configuration-loader-promotion').classList.add('is-visible');
                            document.getElementById('stopCommandPromotion').classList.add('is-visible');
                            document.getElementById('configuration-loader-promotion__text').textContent = data.percentageFormatted;

                            setTimeout("checkCommandPromotion();", 5000);
                        } else {
                            document.getElementById('stopCommandPromotion').classList.remove('is-visible');
                            document.getElementById('configuration-loader-promotion').classList.remove('is-visible');
                            document.getElementById('launchCommandPromotion').classList.add('is-visible');
                        }
                    }
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                });
            }

            function launchCommandPromotion() {
                closeModal(document.getElementById('promotionModal'));
                showLoader();

                postRequest('{{ path('launch_command_promotion') }}')
                .then(response => response.json())
                .then(data => {
                    showAlert(data.success, data.message);
                    checkCommandPromotion();
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }

            function stopCommandPromotion() {
                showLoader();

                postRequest('{{ path('stop_command_promotion') }}')
                .then(response => response.json())
                .then(data => {
                    showAlert(data.success, data.message);
                    checkCommandPromotion();
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}
    </script>
{% endblock %}
