<table class="vehicles">
    <thead>
        <tr>
            <th role="button" data-sort-key="vehicle-name" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-name'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-name']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'name'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="title_update-name" onclick="orderFilter(this, event);"
                {% if filter['order']['title_update-name'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['title_update-name']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'title_update'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            {% if is_granted('VEHICLE_OWN') %}
                <th role="button" data-sort-key="vehicle_user-owned" onclick="orderFilter(this, event);"
                    {% if filter['order']['vehicle_user-owned'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle_user-owned']|lower }}"{% endif %}>
                    <div class="cell"><label>{{ 'owned'|translateLocale|mbUcfirst }}</label></div>
                    {{ include('_partial/arrows.html.twig') }}
                </th>
                <th role="button"><div class="cell"><label>{{ 'property'|translateLocale|mbUcfirst }}</label></div></th>
                <th role="button"><div class="cell"><label>{{ 'wanted_property'|translateLocale|mbUcfirst }}</label></div></th>
            {% endif %}
            <th role="button" data-sort-key="vehicle-seats" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-seats'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-seats']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'seats'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button"><div class="cell"><label>{{ 'vehicle_classes'|translateLocale|mbUcfirst }}</label></div></th>
            <th role="button" data-sort-key="vehicle_drivetrain_locale-name" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle_drivetrain_locale-name'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle_drivetrain_locale-name']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'vehicle_drivetrain'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-price" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-price'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-price']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'price'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-weight" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-weight'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-weight']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'weight'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-gears" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-gears'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-gears']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'gears'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-top_speed_kilometers" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-top_speed_kilometers'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-top_speed_kilometers']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'top_speed'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-top_speed_kilometers_maximum" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-top_speed_kilometers_maximum'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-top_speed_kilometers_maximum']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'top_speed_maximum'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-speed" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-speed'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-speed']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'speed'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-acceleration" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-acceleration'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-acceleration']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'acceleration'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-braking" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-braking'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-braking']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'braking'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-handling" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-handling'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-handling']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'handling'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="vehicle-average" onclick="orderFilter(this, event);"
                {% if filter['order']['vehicle-average'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['vehicle-average']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'average'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button"><div class="cell"><label>{{ 'vehicle_acquisitions'|translateLocale|mbUcfirst }}</label></div></th>
            <th role="button"><div class="cell"><label>{{ 'storage_locations'|translateLocale|mbUcfirst }}</label></div></th>
            <th role="button"><div class="cell"><label>{{ 'delivery_methods'|translateLocale|mbUcfirst }}</label></div></th>
            <th role="button"><div class="cell"><label>{{ 'modification_locations'|translateLocale|mbUcfirst }}</label></div></th>
        </tr>
    </thead>
    <tbody>
        {% for vehicle in vehicles %}
            {% set vehicleOneNames = vehicle.vehicleOneNames is not null ? vehicle.vehicleOneNames|split('+') : [] %}
            {% set vehicleClassIds = vehicle.vehicleClassIds is not null ? vehicle.vehicleClassIds|split('+') : [] %}
            {% set vehicleClassNames = vehicle.vehicleClassNames is not null ? vehicle.vehicleClassNames|split('+') : [] %}
            {% set authorizedPropertyTypeIds = vehicle.authorizedPropertyTypeIds is not null ? vehicle.authorizedPropertyTypeIds|split('+') : [] %}
            {% set vehicleAcquisitionNames = vehicle.vehicleAcquisitionNames is not null ? vehicle.vehicleAcquisitionNames|split('+') : [] %}
            {% set storageLocationNames = vehicle.storageLocationNames is not null ? vehicle.storageLocationNames|split('+') : [] %}
            {% set deliveryMethodNames = vehicle.deliveryMethodNames is not null ? vehicle.deliveryMethodNames|split('+') : [] %}
            {% set modificationLocationNames = vehicle.modificationLocationNames is not null ? vehicle.modificationLocationNames|split('+') : [] %}
            {% set average = vehicle.speed + vehicle.acceleration + vehicle.braking + vehicle.handling %}
            {% set countAverage = 0 %}
            {% if vehicle.speed is not null %}{% set countAverage = countAverage + 1 %}{% endif %}
            {% if vehicle.acceleration is not null %}{% set countAverage = countAverage + 1 %}{% endif %}
            {% if vehicle.braking is not null %}{% set countAverage = countAverage + 1 %}{% endif %}
            {% if vehicle.handling is not null %}{% set countAverage = countAverage + 1 %}{% endif %}

            <tr id="vehicle_{{ vehicle.id }}">
                <td data-sort-value="{{ vehicle.name }}" class="name" id="vehicleName_{{ vehicle.id }}">
                    <div class="cell{% if vehicleOneNames is not empty %} cell_parents{% endif %}{% if vehicle.evolution %} cell_evolution{% endif %}{% if vehicle.optimized %} cell_optimized{% endif %}">
                        {% if vehicle.url %}
                            <a href="{{ vehicle.url }}" target="_blank">{{ vehicle.vehicleManufacturerName ~ ' ' ~ vehicle.name }}</a>
                        {% else %}
                            {{ vehicle.vehicleManufacturerName ~ ' ' ~ vehicle.name }}
                        {% endif %}
                        {% if vehicleOneNames is not empty %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" id="svgParent_{{ vehicle.id }}" class="svgParent">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM288 224C288 206.3 302.3 192 320 192C337.7 192 352 206.3 352 224C352 241.7 337.7 256 320 256C302.3 256 288 241.7 288 224zM280 288L328 288C341.3 288 352 298.7 352 312L352 400L360 400C373.3 400 384 410.7 384 424C384 437.3 373.3 448 360 448L280 448C266.7 448 256 437.3 256 424C256 410.7 266.7 400 280 400L304 400L304 336L280 336C266.7 336 256 325.3 256 312C256 298.7 266.7 288 280 288z" />
                            </svg>
                        {% endif %}
                        {% if vehicle.evolution %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" id="svgEvolution_{{ vehicle.id }}" class="svgEvolution">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M297.4 73.4C309.9 60.9 330.2 60.9 342.7 73.4L470.7 201.4C479.9 210.6 482.6 224.3 477.6 236.3C472.6 248.3 460.9 256 448 256L384 256L384 416C384 504.4 312.4 576 224 576L160 576C142.3 576 128 561.7 128 544L128 480C128 462.3 142.3 448 160 448L224 448C241.7 448 256 433.7 256 416L256 256L192 256C179.1 256 167.4 248.2 162.4 236.2C157.4 224.2 160.2 210.5 169.3 201.3L297.3 73.3z" />
                            </svg>
                        {% endif %}
                        {% if vehicle.optimized %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" id="svgOptimized_{{ vehicle.id }}" class="svgOptimized">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M415.9 274.5C428.1 271.2 440.9 277 446.4 288.3L465 325.9C475.3 327.3 485.4 330.1 494.9 334L529.9 310.7C540.4 303.7 554.3 305.1 563.2 314L582.4 333.2C591.3 342.1 592.7 356.1 585.7 366.5L562.4 401.4C564.3 406.1 566 411 567.4 416.1C568.8 421.2 569.7 426.2 570.4 431.3L608.1 449.9C619.4 455.5 625.2 468.3 621.9 480.4L614.9 506.6C611.6 518.7 600.3 526.9 587.7 526.1L545.7 523.4C539.4 531.5 532.1 539 523.8 545.4L526.5 587.3C527.3 599.9 519.1 611.3 507 614.5L480.8 621.5C468.6 624.8 455.9 619 450.3 607.7L431.7 570.1C421.4 568.7 411.3 565.9 401.8 562L366.8 585.3C356.3 592.3 342.4 590.9 333.5 582L314.3 562.8C305.4 553.9 304 540 311 529.5L334.3 494.5C332.4 489.8 330.7 484.9 329.3 479.8C327.9 474.7 327 469.6 326.3 464.6L288.6 446C277.3 440.4 271.6 427.6 274.8 415.5L281.8 389.3C285.1 377.2 296.4 369 309 369.8L350.9 372.5C357.2 364.4 364.5 356.9 372.8 350.5L370.1 308.7C369.3 296.1 377.5 284.7 389.6 281.5L415.8 274.5zM448.4 404C424.1 404 404.4 423.7 404.5 448.1C404.5 472.4 424.2 492 448.5 492C472.8 492 492.5 472.3 492.5 448C492.4 423.6 472.7 404 448.4 404zM224.9 18.5L251.1 25.5C263.2 28.8 271.4 40.2 270.6 52.7L267.9 94.5C276.2 100.9 283.5 108.3 289.8 116.5L331.8 113.8C344.3 113 355.7 121.2 359 133.3L366 159.5C369.2 171.6 363.5 184.4 352.2 190L314.5 208.6C313.8 213.7 312.8 218.8 311.5 223.8C310.2 228.8 308.4 233.8 306.5 238.5L329.8 273.5C336.8 284 335.4 297.9 326.5 306.8L307.3 326C298.4 334.9 284.5 336.3 274 329.3L239 306C229.5 309.9 219.4 312.7 209.1 314.1L190.5 351.7C184.9 363 172.1 368.7 160 365.5L133.8 358.5C121.6 355.2 113.5 343.8 114.3 331.3L117 289.4C108.7 283 101.4 275.6 95.1 267.4L53.1 270.1C40.6 270.9 29.2 262.7 25.9 250.6L18.9 224.4C15.7 212.3 21.4 199.5 32.7 193.9L70.4 175.3C71.1 170.2 72.1 165.2 73.4 160.1C74.8 155 76.4 150.1 78.4 145.4L55.1 110.5C48.1 100 49.5 86.1 58.4 77.2L77.6 58C86.5 49.1 100.4 47.7 110.9 54.7L145.9 78C155.4 74.1 165.5 71.3 175.8 69.9L194.4 32.3C200 21 212.7 15.3 224.9 18.5zM192.4 148C168.1 148 148.4 167.7 148.4 192C148.4 216.3 168.1 236 192.4 236C216.7 236 236.4 216.3 236.4 192C236.4 167.7 216.7 148 192.4 148z" />
                            </svg>
                        {% endif %}
                    </div>
                </td>
                <td data-sort-value="{{ vehicle.titleUpdateName }}" class="titleUpdateName"><div class="cell">{{ vehicle.titleUpdateName }}</div></td>
                {% if is_granted('VEHICLE_OWN') %}
                    <td data-sort-value="{{ vehicle.owned ? 1 : 0 }}" class="owned key">
                        <div class="cell">
                            <div class="checkbox-wrapper-2">
                                <input type="checkbox" value="1"{% if vehicle.owned %} checked{% endif %} class="stylized" id="vehicleOwned_{{ vehicle.id }}"
                                       onchange="editVehicle({{ vehicle.id }}, this);" />
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="cell">
                            <select id="vehiclePropertyId_{{ vehicle.id }}" onchange="editVehicle({{ vehicle.id }}, this);">
                                <option value="">{{ 'choose_the_property'|translateLocale|mbUcfirst }}...</option>
                                {% for property in properties %}
                                    {% set authorized = false %}
                                    {% if property.propertyTwos is not empty %}
                                        {% for propertyTwo in property.propertyTwos %}
                                            {% if propertyTwo.propertyTypeId
                                                and (not propertyTwo.propertyTypeId or propertyTwo.propertyTypeId in authorizedPropertyTypeIds)
                                            %}
                                                {% set authorized = true %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    {% if not authorized and property.propertyTypeId
                                        and (not property.propertyTypeId or property.propertyTypeId in authorizedPropertyTypeIds)
                                    %}
                                        {% set authorized = true %}
                                    {% endif %}
                                    {% if authorized %}
                                        {% if constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds %}
                                            <option value="{{ property.id }}" data-number-vehicles="{{ property.numberVehiclesBicycles }}"
                                                    data-number-max-vehicles="{{ property.capacityBicycles }}"
                                                    data-search="{{ property.name }}{% for propertyTwo in property.propertyTwos %} {{ propertyTwo.name }}{% endfor %}"
                                                {% if vehicle.propertyId and vehicle.propertyId == property.id %} selected{% endif %}
                                                {% if property.numberVehiclesBicycles >= property.capacityBicycles %} disabled{% endif %}>{{ property.name ~ ' (' ~ property.numberVehiclesBicycles ~ '/' ~ property.capacityBicycles ~ ')' }}</option>
                                        {% else %}
                                            <option value="{{ property.id }}" data-number-vehicles="{{ property.numberVehiclesNotBicycles }}"
                                                    data-number-max-vehicles="{{ property.capacityVehicles }}"
                                                    data-search="{{ property.name }} {% for propertyTwo in property.propertyTwos %} {{ propertyTwo.name }}{% endfor %}"
                                                {% if vehicle.propertyId and vehicle.propertyId == property.id %} selected{% endif %}
                                                {% if property.numberVehiclesNotBicycles >= property.capacityVehicles %} disabled{% endif %}>{{ property.name ~ ' (' ~ property.numberVehiclesNotBicycles ~ '/' ~ property.capacityVehicles ~ ')' }}</option>
                                        {% endif %}
                                    {% endif %}
                                    {% if property.propertyTwos is not empty %}
                                        {% for propertyTwo in property.propertyTwos %}
                                            {% if propertyTwo.propertyTypeId
                                                and (not propertyTwo.propertyTypeId or propertyTwo.propertyTypeId in authorizedPropertyTypeIds)
                                            %}
                                                {% if constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds %}
                                                    <option value="{{ propertyTwo.id }}" data-number-vehicles="{{ propertyTwo.numberVehiclesBicycles }}"
                                                            data-number-max-vehicles="{{ propertyTwo.capacityBicycles }}"
                                                            data-search="{{ propertyTwo.name }} {{ property.name }}"
                                                        {% if vehicle.propertyId and vehicle.propertyId == propertyTwo.id %} selected{% endif %}
                                                        {% if propertyTwo.numberVehiclesBicycles >= propertyTwo.capacityBicycles %} disabled{% endif %}>{{ '--- ' ~ propertyTwo.name ~ ' (' ~ propertyTwo.numberVehiclesBicycles ~ '/' ~ propertyTwo.capacityBicycles ~ ')' }}</option>
                                                {% else %}
                                                    <option value="{{ propertyTwo.id }}" data-number-vehicles="{{ propertyTwo.numberVehiclesNotBicycles }}"
                                                            data-number-max-vehicles="{{ propertyTwo.capacityVehicles }}"
                                                            data-search="{{ propertyTwo.name }} {{ property.name }}"
                                                        {% if vehicle.propertyId and vehicle.propertyId == propertyTwo.id %} selected{% endif %}
                                                        {% if propertyTwo.numberVehiclesNotBicycles >= propertyTwo.capacityVehicles %} disabled{% endif %}>{{ '--- ' ~ propertyTwo.name ~ ' (' ~ propertyTwo.numberVehiclesNotBicycles ~ '/' ~ propertyTwo.capacityVehicles ~ ')' }}</option>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </td>
                    <td class="wantedProperty">
                        <div class="cell">
                            <select id="vehicleWantedPropertyId_{{ vehicle.id }}" onchange="editVehicle({{ vehicle.id }}, this);">
                                <option value="">{{ 'choose_the_wanted_property'|translateLocale|mbUcfirst }}...</option>
                                {% for wantedProperty in wantedProperties %}
                                    {% set authorized = false %}
                                    {% if wantedProperty.propertyTwos is not empty %}
                                        {% for wantedPropertyTwo in wantedProperty.propertyTwos %}
                                            {% if wantedPropertyTwo.propertyTypeId
                                                and (not wantedPropertyTwo.propertyTypeId
                                                    or wantedPropertyTwo.propertyTypeId in authorizedPropertyTypeIds
                                                )
                                            %}
                                                {% set authorized = true %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    {% if not authorized and wantedProperty.propertyTypeId
                                        and (not wantedProperty.propertyTypeId or wantedProperty.propertyTypeId in authorizedPropertyTypeIds)
                                    %}
                                        {% set authorized = true %}
                                    {% endif %}
                                    {% if authorized %}
                                        {% if constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds %}
                                            <option value="{{ wantedProperty.id }}" data-number-vehicles="{{ wantedProperty.numberVehiclesBicycles }}"
                                                    data-number-max-vehicles="{{ wantedProperty.capacityBicycles }}"
                                                    data-search="{{ wantedProperty.name }}{% for wantedPropertyTwo in wantedProperty.propertyTwos %} {{ wantedPropertyTwo.name }}{% endfor %}"
                                                {% if vehicle.wantedPropertyId and vehicle.wantedPropertyId == wantedProperty.id %} selected{% endif %}
                                                {% if wantedProperty.numberVehiclesBicycles >= wantedProperty.capacityBicycles %} disabled{% endif %}>{{ wantedProperty.name ~ ' (' ~ wantedProperty.numberVehiclesBicycles ~ '/' ~ wantedProperty.capacityBicycles ~ ')' }}</option>
                                        {% else %}
                                            <option value="{{ wantedProperty.id }}" data-number-vehicles="{{ wantedProperty.numberVehiclesNotBicycles }}"
                                                    data-number-max-vehicles="{{ wantedProperty.capacityVehicles }}"
                                                    data-search="{{ wantedProperty.name }}{% for wantedPropertyTwo in wantedProperty.propertyTwos %} {{ wantedPropertyTwo.name }}{% endfor %}"
                                                {% if vehicle.wantedPropertyId and vehicle.wantedPropertyId == wantedProperty.id %} selected{% endif %}
                                                {% if wantedProperty.numberVehiclesNotBicycles >= wantedProperty.capacityVehicles %} disabled{% endif %}>{{ wantedProperty.name ~ ' (' ~ wantedProperty.numberVehiclesNotBicycles ~ '/' ~ wantedProperty.capacityVehicles ~ ')' }}</option>
                                        {% endif %}
                                    {% endif %}
                                    {% if wantedProperty.propertyTwos is not empty %}
                                        {% for wantedPropertyTwo in wantedProperty.propertyTwos %}
                                            {% if wantedPropertyTwo.propertyTypeId
                                                and (not wantedPropertyTwo.propertyTypeId or wantedPropertyTwo.propertyTypeId in authorizedPropertyTypeIds)
                                            %}
                                                {% if constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds %}
                                                    <option value="{{ wantedPropertyTwo.id }}"
                                                            data-number-vehicles="{{ wantedPropertyTwo.numberVehiclesBicycles }}"
                                                            data-number-max-vehicles="{{ wantedPropertyTwo.capacityBicycles }}"
                                                            data-search="{{ wantedPropertyTwo.name }} {{ wantedProperty.name }}"
                                                        {% if vehicle.wantedPropertyId and vehicle.wantedPropertyId == wantedPropertyTwo.id %} selected{% endif %}
                                                        {% if wantedPropertyTwo.numberVehiclesBicycles >= wantedPropertyTwo.capacityBicycles %} disabled{% endif %}>{{ '--- ' ~ wantedPropertyTwo.name ~ ' (' ~ wantedPropertyTwo.numberVehiclesBicycles ~ '/' ~ wantedPropertyTwo.capacityBicycles ~ ')' }}</option>
                                                {% else %}
                                                    <option value="{{ wantedPropertyTwo.id }}"
                                                            data-number-vehicles="{{ wantedPropertyTwo.numberVehiclesNotBicycles }}"
                                                            data-number-max-vehicles="{{ wantedPropertyTwo.capacityVehicles }}"
                                                            data-search="{{ wantedPropertyTwo.name }} {{ wantedProperty.name }}"
                                                        {% if vehicle.wantedPropertyId and vehicle.wantedPropertyId == wantedPropertyTwo.id %} selected{% endif %}
                                                        {% if wantedPropertyTwo.numberVehiclesNotBicycles >= wantedPropertyTwo.capacityVehicles %} disabled{% endif %}>{{ '--- ' ~ wantedPropertyTwo.name ~ ' (' ~ wantedPropertyTwo.numberVehiclesNotBicycles ~ '/' ~ wantedPropertyTwo.capacityVehicles ~ ')' }}</option>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </td>
                {% endif %}
                <td data-sort-value="{{ vehicle.seats ? vehicle.seats : 0 }}" class="seats"><div class="cell">{{ vehicle.seats }}</div></td>
                <td class="className key">
                    <div class="cell">
                        {% if vehicleClassNames is not empty %}
                            {% for vehicleClassName in vehicleClassNames %}
                                <span class="nowrap">{{ vehicleClassName }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                </td>
                <td data-sort-value="{{ vehicle.vehicleDrivetrainName }}" class="vehicleDrivetrainName">
                    <div class="cell">{{ vehicle.vehicleDrivetrainName }}</div>
                </td>
                <td data-sort-value="{{ vehicle.price ? vehicle.price : 0 }}" class="price key">
                    <div class="cell{% if vehicle.discountedPrice or vehicle.discountedPercentage or vehicle.comment or vehicle.unlockVehicle %} cell_info{% endif %}">
                        {{ vehicle.price ? vehicle.price|formatNumber : '' }}
                        {% if vehicle.discountedPercentage %}
                            <br/>
                            {{ 'promo'|translateLocale|mbUcfirst }}  : {{ (vehicle.price * (100 - vehicle.discountedPercentage) / 100)|formatNumber }}
                            ({{ vehicle.discountedPercentage|formatPercent }})
                        {% endif %}
                        {% if vehicle.discountedPrice %}
                            <br/>
                            {{ 'discount'|translateLocale|mbUcfirst }}  : {{ vehicle.discountedPrice|formatNumber }}
                            ({{ (100 - (vehicle.discountedPrice / vehicle.price * 100))|formatPercent }})
                            {% if vehicle.discountedPercentage %}
                                <br/>
                                {{ 'promo_discount'|translateLocale|mbUcfirst }}  : {{ (vehicle.discountedPrice * (100 - vehicle.discountedPercentage) / 100)|formatNumber }}
                                ({{ (100 - (vehicle.discountedPrice * (100 - vehicle.discountedPercentage) / vehicle.price))|formatPercent }})
                            {% endif %}
                        {% endif %}
                        {% if vehicle.comment or vehicle.unlockVehicle %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" id="svgInfo_{{ vehicle.id }}">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path d="M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM288 224C288 206.3 302.3 192 320 192C337.7 192 352 206.3 352 224C352 241.7 337.7 256 320 256C302.3 256 288 241.7 288 224zM280 288L328 288C341.3 288 352 298.7 352 312L352 400L360 400C373.3 400 384 410.7 384 424C384 437.3 373.3 448 360 448L280 448C266.7 448 256 437.3 256 424C256 410.7 266.7 400 280 400L304 400L304 336L280 336C266.7 336 256 325.3 256 312C256 298.7 266.7 288 280 288z" />
                            </svg>
                        {% endif %}
                    </div>
                </td>
                <td data-sort-value="{{ vehicle.weight ? vehicle.weight : 0 }}" class="weight">
                    <div class="cell">{{ vehicle.weight ? vehicle.weight|formatNumber : '' }}</div>
                </td>
                <td data-sort-value="{{ vehicle.gears ? vehicle.gears : 0 }}" class="gears">
                    <div class="cell">{{ vehicle.gears ? vehicle.gears : '' }}</div>
                </td>
                <td data-sort-value="{{ vehicle.topSpeedKilometers ? vehicle.topSpeedKilometers : 0 }}" class="topSpeed">
                    <div class="cell">{{ vehicle.topSpeedKilometers|formatSpeed(vehicle.topSpeedMiles) }}</div>
                </td>
                <td data-sort-value="{{ vehicle.topSpeedKilometersMaximum ? vehicle.topSpeedKilometersMaximum : 0 }}" class="topSpeedMaximum">
                    <div class="cell">
                        {{ vehicle.topSpeedKilometersMaximum|formatSpeed(vehicle.topSpeedMilesMaximum) }}
                    </div>
                </td>
                <td data-sort-value="{{ vehicle.speed ? vehicle.speed : 0 }}" class="speed">
                    <div class="cell">{{ vehicle.speed is not null ? vehicle.speed|formatPercent(2) : '' }}</div>
                </td>
                <td data-sort-value="{{ vehicle.acceleration ? vehicle.acceleration : 0 }}" class="acceleration">
                    <div class="cell">{{ vehicle.acceleration is not null ? vehicle.acceleration|formatPercent(2) : '' }}</div>
                </td>
                <td data-sort-value="{{ vehicle.braking ? vehicle.braking : 0 }}" class="braking">
                    <div class="cell">{{ vehicle.braking is not null ? vehicle.braking|formatPercent(2) : '' }}</div>
                </td>
                <td data-sort-value="{{ vehicle.handling ? vehicle.handling : 0 }}" class="handling">
                    <div class="cell">{{ vehicle.handling is not null ? vehicle.handling|formatPercent(2) : '' }}</div>
                </td>
                <td data-sort-value="{{ countAverage ? average / countAverage : 0 }}" class="average key">
                    <div class="cell">{{ countAverage ? (average / countAverage)|formatPercent(2) : '' }}</div>
                </td>
                <td>
                    <div class="cell">
                        {% if vehicleAcquisitionNames is not empty %}
                            {% for vehicleAcquisitionName in vehicleAcquisitionNames %}
                                <span class="nowrap">{{ vehicleAcquisitionName }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div class="cell">
                        {% if storageLocationNames is not empty %}
                            {% for storageLocationName in storageLocationNames %}
                                <span class="nowrap">{{ storageLocationName }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div class="cell">
                        {% if deliveryMethodNames is not empty %}
                            {% for deliveryMethodName in deliveryMethodNames %}
                                <span class="nowrap">{{ deliveryMethodName }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div class="cell">
                        {% if modificationLocationNames is not empty %}
                            {% for modificationLocationName in modificationLocationNames %}
                                <span class="nowrap">{{ modificationLocationName }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                    {% if is_granted('VEHICLE_EDIT') %}
                        <button class="btn btn-warning" data-modal-open="#vehicleModal" data-vehicle-id="{{ vehicle.id }}" data-vehicle-name="{{ vehicle.name }}"
                                id="formVehicle_{{ vehicle.id }}">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#FFFFFF" d="M100.4 417.2C104.5 402.6 112.2 389.3 123 378.5L304.2 197.3L338.1 163.4C354.7 180 389.4 214.7 442.1 267.4L476 301.3L442.1 335.2L260.9 516.4C250.2 527.1 236.8 534.9 222.2 539L94.4 574.6C86.1 576.9 77.1 574.6 71 568.4C64.9 562.2 62.6 553.3 64.9 545L100.4 417.2zM156 413.5C151.6 418.2 148.4 423.9 146.7 430.1L122.6 517L209.5 492.9C215.9 491.1 221.7 487.8 226.5 483.2L155.9 413.5zM510 267.4C493.4 250.8 458.7 216.1 406 163.4L372 129.5C398.5 103 413.4 88.1 416.9 84.6C430.4 71 448.8 63.4 468 63.4C487.2 63.4 505.6 71 519.1 84.6L554.8 120.3C568.4 133.9 576 152.3 576 171.4C576 190.5 568.4 209 554.8 222.5C551.3 226 536.4 240.9 509.9 267.4z" />
                            </svg>
                        </button>
                    {% endif %}
                    {% if is_granted('VEHICLE_ADD') %}
                        <button class="btn btn-info" data-modal-open="#vehicleModal" data-vehicle-copy-id="{{ vehicle.id }}" data-vehicle-name="{{ vehicle.name }}"
                                id="duplicateVehicle_{{ vehicle.id }}">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#FFFFFF" d="M288 64C252.7 64 224 92.7 224 128L224 384C224 419.3 252.7 448 288 448L480 448C515.3 448 544 419.3 544 384L544 183.4C544 166 536.9 149.3 524.3 137.2L466.6 81.8C454.7 70.4 438.8 64 422.3 64L288 64zM160 192C124.7 192 96 220.7 96 256L96 512C96 547.3 124.7 576 160 576L352 576C387.3 576 416 547.3 416 512L416 496L352 496L352 512L160 512L160 256L176 256L176 192L160 192z" />
                            </svg>
                        </button>
                    {% endif %}
                    {% if is_granted('VEHICLE_DELETE') %}
                        <button class="btn btn-danger" data-modal-open="#vehicleModal" data-delete data-vehicle-id="{{ vehicle.id }}" data-vehicle-name="{{ vehicle.name }}"
                                id="deleteVehicle_{{ vehicle.id }}">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#FFFFFF" d="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z" />
                            </svg>
                        </button>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th>
                <div class="pagination">
                    {{ include('Widget/pagination.html.twig') }}
                </div>
            </th>
        </tr>
    </tfoot>
</table>
