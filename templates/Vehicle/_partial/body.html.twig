<div class="group">
    <div class="form-group" style="--filter-width: 20%;">
        <label class="form-label required" for="name">{{ 'name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="name" id="name"{% if vehicle and vehicle.name %} value="{{ vehicle.name }}"{% endif %} class="form-input" />
        <div class="error" id="error_name">{{ 'please_enter_the_name'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 20%;">
        <label class="form-label" for="vehicleManufacturerId">{{ 'vehicle_manufacturer'|translateLocale|mbUcfirst }}</label>
        <select name="vehicleManufacturerId" id="vehicleManufacturerId">
            <option value="">{{ 'select_a_vehicle_manufacturer'|translateLocale|mbUcfirst }}</option>
            {% for vehicleManufacturer in vehicleManufacturers %}
                <option value="{{ vehicleManufacturer.id }}"
                    {% if vehicle and vehicleManufacturer.id == vehicle.vehicleManufacturerId %} selected{% endif %}>{{ vehicleManufacturer.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="form-group" style="--filter-width: 10%;">
        <label class="form-label" for="evolution">{{ 'evolution'|translateLocale|mbUcfirst }}</label>
        <div class="checkbox-wrapper-2">
            <input type="checkbox" name="evolution" id="evolution" value="1"{% if vehicle and vehicle.evolution %} checked{% endif %} class="stylized" />
        </div>
    </div>
    <div class="form-group" style="--filter-width: 25%;">
        {% set vehicleOneIds = [] %}
        {% set vehicleOneNames = [] %}
        {% if vehicle %}
            {% if vehicle.vehicleOneIds is not null %}
                {% set vehicleOneIds = vehicle.vehicleOneIds|split('+') %}
            {% endif %}
            {% if vehicle.vehicleOneNames is not null %}
                {% set vehicleOneNames = vehicle.vehicleOneNames|split('+') %}
            {% endif %}
        {% endif %}
        <label class="form-label" for="vehicleOneIds">{{ 'parents'|translateLocale|mbUcfirst }}</label>
        <select name="vehicleOneIds[]" id="vehicleOneIds" multiple data-multi-select>
            {% if vehicleOneIds is not empty %}
                {% for key, vehicleOneId in vehicleOneIds %}
                    <option value="{{ vehicleOneId }}" selected>{{ vehicleOneNames[key] ?? '' }}</option>
                {% endfor %}
            {% endif %}
            {% if vehicleOnes is not empty %}
                {% for vehicleOne in vehicleOnes %}
                    {% if vehicleOne.id not in vehicleOneIds and (not vehicle or copy or vehicle.id != vehicleOne.id) %}
                        <option value="{{ vehicleOne.id }}">{{ vehicleOne.name }}</option>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </select>
    </div>
    <div class="form-group" style="--filter-width: 25%;">
        {% set vehicleClassIds = [] %}
        {% set vehicleClassNames = [] %}
        {% if vehicle %}
            {% if vehicle.vehicleClassIds is not null %}
                {% set vehicleClassIds = vehicle.vehicleClassIds|split('+') %}
            {% endif %}
            {% if vehicle.vehicleClassNames is not null %}
                {% set vehicleClassNames = vehicle.vehicleClassNames|split('+') %}
            {% endif %}
        {% endif %}
        <label class="form-label" for="vehicleClassIds">{{ 'vehicle_classes'|translateLocale|mbUcfirst }}</label>
        <select name="vehicleClassIds[]" id="vehicleClassIds" multiple data-multi-select>
            {% if vehicleClassIds is not empty %}
                {% for key, vehicleClassId in vehicleClassIds %}
                    <option value="{{ vehicleClassId }}" selected>{{ vehicleClassNames[key] ?? '' }}</option>
                {% endfor %}
            {% endif %}
            {% if vehicleClassLocales is not empty %}
                {% for vehicleClassLocale in vehicleClassLocales %}
                    {% if vehicleClassLocale.vehicleClass.id not in vehicleClassIds %}
                        <option value="{{ vehicleClassLocale.vehicleClass.id }}">{{ vehicleClassLocale.name }}</option>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </select>
    </div>
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 10%;">
        <label class="form-label" for="price">{{ 'price'|translateLocale|mbUcfirst }}</label>
        <input type="number" min="0" step="1" name="price" id="price" value="{{ vehicle ? vehicle.price : '' }}" class="form-input" />
    </div>
    <div class="form-group" style="--filter-width: 10%;">
        <label class="form-label" for="discountedPrice">{{ 'discounted_price'|translateLocale|mbUcfirst }}</label>
        <input type="number" min="0" step="1" name="discountedPrice" id="discountedPrice" value="{{ vehicle ? vehicle.discountedPrice : '' }}"
               class="form-input" />
    </div>
    <div class="form-group" style="--filter-width: 10%;">
        <label class="form-label" for="topSpeedKilometers">{{ 'top_speed'|translateLocale|mbUcfirst }}</label>
        <input type="number" min="0" step="0.01" name="topSpeedKilometers" id="topSpeedKilometers" value="{{ vehicle ? vehicle.topSpeedKilometers : '' }}"
               class="form-input" />
    </div>
    <div class="form-group" style="--filter-width: 10%;">
        <label class="form-label" for="topSpeedKilometersMaximum">{{ 'top_speed_maximum'|translateLocale|mbUcfirst }}</label>
        <input type="number" min="0" step="1" name="topSpeedKilometersMaximum" id="topSpeedKilometersMaximum"
               value="{{ vehicle ? vehicle.topSpeedKilometersMaximum : '' }}" class="form-input" />
    </div>
    <div class="form-group" style="--filter-width: 10%;">
        <label class="form-label" for="owned">{{ 'owned'|translateLocale|mbUcfirst }}</label>
        <div class="checkbox-wrapper-2">
            <input type="checkbox" name="owned" id="owned" value="1"{% if vehicle and vehicle.owned %} checked{% endif %} class="stylized"
                   onclick="checkVehicleModal();" />
        </div>
    </div>
    <div class="form-group" style="--filter-width: 25%;">
        <label class="form-label" for="propertyId">{{ 'property'|translateLocale|mbUcfirst }}</label>
        <select name="propertyId" id="propertyId">
            <option value="" data-storage-location-ids="[]" data-number-vehicles-not-bicycles="0" data-number-max-vehicles="0" data-number-vehicles-bicycles="0"
                    data-number-max-bicycles="0">{{ 'select_the_property'|translateLocale|mbUcfirst }}</option>
            {% for property in properties %}
                <option value="{{ property.id }}" data-storage-location-ids="[{{ property.storageLocationIds }}]" data-property-name="{{ property.name }}"
                        data-number-vehicles-not-bicycles="{{ property.numberVehiclesNotBicycles }}"
                        data-number-max-vehicles="{{ property.capacityVehicles }}"
                        data-number-vehicles-bicycles="{{ property.numberVehiclesBicycles }}" data-number-max-bicycles="{{ property.capacityBicycles }}"
                        data-search="{{ property.name }} {% for propertyTwo in property.propertyTwos %} {{ propertyTwo.name }}{% endfor %}"
                    {% if vehicle and property.id == vehicle.propertyId %} selected{% endif %}>{{ property.name ~ ' (' ~ (constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds ? (property.numberVehiclesBicycles ~ '/' ~ property.capacityBicycles) : (property.numberVehiclesNotBicycles ~ '/' ~ property.capacityVehicles)) ~ ')' }}</option>
                {% if property.propertyTwos is not empty %}
                    {% for propertyTwo in property.propertyTwos %}
                        {% if propertyTwo.storageLocationIds %}
                            <option value="{{ propertyTwo.id }}" data-storage-location-ids="[{{ propertyTwo.storageLocationIds }}]"
                                    data-property-name="{{ propertyTwo.name }}"
                                    data-number-vehicles-not-bicycles="{{ propertyTwo.numberVehiclesNotBicycles }}"
                                    data-number-max-vehicles="{{ propertyTwo.capacityVehicles }}"
                                    data-number-vehicles-bicycles="{{ propertyTwo.numberVehiclesBicycles }}"
                                    data-number-max-bicycles="{{ propertyTwo.capacityBicycles }}"
                                    data-search="{{ propertyTwo.name }} {{ property.name }}"
                                {% if vehicle and vehicle.propertyId == propertyTwo.id %} selected{% endif %}>{{ '--- ' ~ propertyTwo.name ~ ' (' ~ (constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds ? (propertyTwo.numberVehiclesBicycles ~ '/' ~ propertyTwo.capacityBicycles) : (propertyTwo.numberVehiclesNotBicycles ~ '/' ~ propertyTwo.capacityVehicles)) ~ ')' }}</option>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </select>
    </div>
    <div class="form-group" style="--filter-width: 25%;">
        <label class="form-label" for="wantedPropertyId">{{ 'wanted_property'|translateLocale|mbUcfirst }}</label>
        <select name="wantedPropertyId" id="wantedPropertyId">
            <option value="" data-storage-location-ids="[]" data-number-vehicles-not-bicycles="0" data-number-max-vehicles="0" data-number-vehicles-bicycles="0"
                    data-number-max-bicycles="0">{{ 'select_the_wanted_property'|translateLocale|mbUcfirst }}</option>
            {% for wantedProperty in wantedProperties %}
                <option value="{{ wantedProperty.id }}" data-storage-location-ids="[{{ wantedProperty.storageLocationIds }}]"
                        data-wanted-property-name="{{ wantedProperty.name }}"
                        data-number-vehicles-not-bicycles="{{ wantedProperty.numberVehiclesNotBicycles }}"
                        data-number-max-vehicles="{{ wantedProperty.capacityVehicles }}"
                        data-number-vehicles-bicycles="{{ wantedProperty.numberVehiclesBicycles }}"
                        data-number-max-bicycles="{{ wantedProperty.capacityBicycles }}"
                    {% if vehicle and wantedProperty.id == vehicle.wantedPropertyId %} selected{% endif %}>{{ wantedProperty.name ~ ' (' ~ (constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds ? (wantedProperty.numberVehiclesBicycles ~ '/' ~ wantedProperty.capacityBicycles) : (wantedProperty.numberVehiclesNotBicycles ~ '/' ~ wantedProperty.capacityVehicles)) ~ ')' }}</option>
                {% if wantedProperty.propertyTwos is not empty %}
                    {% for wantedPropertyTwo in wantedProperty.propertyTwos %}
                        {% if wantedPropertyTwo.storageLocationIds %}
                            <option value="{{ wantedPropertyTwo.id }}" data-storage-location-ids="[{{ wantedPropertyTwo.storageLocationIds }}]"
                                    data-wanted-property-name="{{ '--- ' ~ wantedPropertyTwo.name }}"
                                    data-number-vehicles-not-bicycles="{{ wantedPropertyTwo.numberVehiclesNotBicycles }}"
                                    data-number-max-vehicles="{{ wantedPropertyTwo.capacityVehicles }}"
                                    data-number-vehicles-bicycles="{{ wantedPropertyTwo.numberVehiclesBicycles }}"
                                    data-number-max-bicycles="{{ wantedPropertyTwo.capacityBicycles }}"
                                {% if vehicle and vehicle.wantedPropertyId == wantedPropertyTwo.id %} selected{% endif %}>{{ '--- ' ~ wantedPropertyTwo.name ~ ' (' ~ (constant('App\\Entity\\VehicleClass::BICYCLES_ID') ~ '' in vehicleClassIds ? (wantedPropertyTwo.numberVehiclesBicycles ~ '/' ~ wantedPropertyTwo.capacityBicycles) : (wantedPropertyTwo.numberVehiclesNotBicycles ~ '/' ~ wantedPropertyTwo.capacityVehicles)) ~ ')' }}</option>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </select>
    </div>
</div>
