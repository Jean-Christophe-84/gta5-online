<table class="loginErrors">
    <thead>
        <tr>
            <th role="button" data-sort-key="login_error-date" onclick="orderFilter(this, event);"
                {% if filter['order']['login_error-date'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['login_error-date']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'date'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig', {sortKey: 'login_error-date'}) }}
            </th>
            <th role="button" data-sort-key="login_error-email" onclick="orderFilter(this, event);"
                {% if filter['order']['login_error-email'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['login_error-email']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'entered_mail'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig', {sortKey: 'login_error-email'}) }}
            </th>
            <th role="button" data-sort-key="login_error-ip" onclick="orderFilter(this, event);"
                {% if filter['order']['login_error-ip'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['login_error-ip']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'ip_address'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig', {sortKey: 'login_error-ip'}) }}
            </th>
        </tr>
    </thead>
    <tbody>
        {% for loginError in loginErrors %}
            <tr id="loginError_{{ loginError.id }}">
                <td data-sort-value="{{ loginError.date }}" class="date"><div class="cell">{{ 'date_time'|translateLocale({date: date(loginError.date)}) }}</div></td>
                <td data-sort-value="{{ loginError.email }}" class="email"><div class="cell">{{ loginError.email }}</div></td>
                <td data-sort-value="{{ loginError.ip }}" class="ip"><div class="cell">{{ loginError.ip }}</div></td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">
                <div class="pagination">
                    {{ include('Widget/pagination.html.twig') }}
                </div>
            </th>
        </tr>
    </tfoot>
</table>
