    <select id="filterBusinessId">
        <option value="0"{% if filter.businessId == 0 %} selected{% endif %}>{{ 'all'|translateLocale({gender: 'feminine'})|mbUcfirst }}</option>
        {% for filterBusinessId in filterBusinessIds %}
            <option value="{{ filterBusinessId.id }}"
