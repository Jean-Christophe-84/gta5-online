{% if is_granted('PROPERTY_OWN') %}
    <div class="filter" style="--filter-grow: 6;">
        <label class="form-label" for="filterOwned">{{ 'owned'|translateLocale|mbUcfirst }}</label>
        <select id="filterOwned">
            <option value="null"{% if filter.owned is same as(null) %} selected{% endif %}>{{ 'all'|translateLocale({gender: 'masculine'})|mbUcfirst }}</option>
            {% for filterOwned in filterOwneds %}
                <option value="{{ filterOwned.owned }}"
                    {% if not filter.owned is same as(null) and filter.owned == filterOwned.owned %} selected{% endif %}>{{ (filterOwned.owned == 1 ? 'yes'|translateLocale|mbUcfirst : 'no'|translateLocale|mbUcfirst) ~ ' (' ~ filterOwned.numberProperties ~ ')' }}</option>
            {% endfor %}
        </select>
    </div>
{% else %}
    <input type="hidden" id="filterOwned" value="null" />
{% endif %}
{% if is_granted('PROPERTY_OWN') %}
    <div class="filter" style="--filter-grow: 9;">
        <label class="form-label" for="filterWanted">{{ 'wanted'|translateLocale|mbUcfirst }}</label>
        <select id="filterWanted">
            <option value="null"{% if filter.wanted is same as(null) %} selected{% endif %}>{{ 'all'|translateLocale({gender: 'masculine'})|mbUcfirst }}</option>
            {% for filterWanted in filterWanteds %}
                <option value="{{ filterWanted.wanted }}"
                    {% if not filter.wanted is same as(null) and filter.wanted == filterWanted.wanted %} selected{% endif %}>{{ (filterWanted.wanted == 1 ? 'yes'|translateLocale|mbUcfirst : 'no'|translateLocale|mbUcfirst) ~ ' (' ~ filterWanted.numberProperties ~ ')' }}</option>
            {% endfor %}
        </select>
    </div>
{% else %}
    <input type="hidden" id="filterWanted" value="null" />
{% endif %}
<div class="filter" style="--filter-grow: 8;">
    <label class="form-label" for="filterPropertyTypeId">{{ 'property_type'|translateLocale|mbUcfirst }} ({{ filterPropertyTypeIds|length }})</label>
    <select id="filterPropertyTypeId">
        <option value="0">{{ 'all'|translateLocale({gender: 'feminine'})|mbUcfirst }}</option>
        {% for filterPropertyTypeId in filterPropertyTypeIds %}
            <option value="{{ filterPropertyTypeId.id }}"
                {% if filter.propertyTypeId == filterPropertyTypeId.id %} selected{% endif %}>{{ filterPropertyTypeId.name ~ ' (' ~ filterPropertyTypeId.numberProperties ~ ')' }}</option>
        {% endfor %}
    </select>
</div>
