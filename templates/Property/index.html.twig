{% extends "layout.html.twig" %}

{% block title %}{{ 'properties'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content">
        {{ include('_partial/alert.html.twig') }}
        {{ include('_partial/tips.html.twig', {tips: tips('properties')}) }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a onclick="launchCommandProperty();" class="btn btn-success{% if not configuration.percentageVehicles and not configuration.percentageProperties and not configuration.percentageWeapons and not configuration.percentagePromotions %} is-visible{% endif %}" id="launchCommandProperty">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M73.4 182.6C60.9 170.1 60.9 149.8 73.4 137.3C85.9 124.8 106.2 124.8 118.7 137.3L278.7 297.3C291.2 309.8 291.2 330.1 278.7 342.6L118.7 502.6C106.2 515.1 85.9 515.1 73.4 502.6C60.9 490.1 60.9 469.8 73.4 457.3L210.7 320L73.4 182.6zM288 448L544 448C561.7 448 576 462.3 576 480C576 497.7 561.7 512 544 512L288 512C270.3 512 256 497.7 256 480C256 462.3 270.3 448 288 448z" />
                    </svg>
                </a>
                <a onclick="stopCommandProperty();" class="btn btn-danger{% if configuration.percentageProperties %} is-visible{% endif %}" id="stopCommandProperty">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 96C352 78.3 337.7 64 320 64C302.3 64 288 78.3 288 96L288 304C288 312.8 280.8 320 272 320C263.2 320 256 312.8 256 304L256 128C256 110.3 241.7 96 224 96C206.3 96 192 110.3 192 128L192 400C192 401.5 192 403.1 192.1 404.6L131.6 347C115.6 331.8 90.3 332.4 75 348.4C59.7 364.4 60.4 389.7 76.4 405L188.8 512C231.9 553.1 289.2 576 348.8 576L368 576C465.2 576 544 497.2 544 400L544 192C544 174.3 529.7 160 512 160C494.3 160 480 174.3 480 192L480 304C480 312.8 472.8 320 464 320C455.2 320 448 312.8 448 304L448 128C448 110.3 433.7 96 416 96C398.3 96 384 110.3 384 128L384 304C384 312.8 376.8 320 368 320C359.2 320 352 312.8 352 304L352 96z" />
                    </svg>
                </a>
                <div id="configuration-loader-property" class="configuration-loader{% if configuration.percentageProperties %} is-visible{% endif %}" role="status" aria-live="polite">
                    <div class="configuration-loader__spinner" aria-hidden="true"></div>
                    <div id="configuration-loader-property__text" class="configuration-loader__text">{{ configuration.percentageProperties|formatPercent(2, true) }}</div>
                </div>
            {% endif %}
        </div>
        <div class="include filters">
            {{ include('Property/_partial/filter.html.twig') }}
        </div>
        {% if is_granted('PROPERTY_ADD') %}
            <div class="addProperty" id="addProperty">
                <button class="btn btn-primary" data-modal-open="#propertyModal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                    </svg>
                </button>
            </div>
        {% endif %}
        <div class="include filters filters_two">
            {{ include('Property/_partial/filter_two.html.twig') }}
        </div>
        {% if is_granted('PROPERTY_OWN') %}
            <div class="include summary">
                {{ include('_partial/summary.html.twig', {entity: 'properties'}) }}
            </div>
        {% endif %}
        <div class="table-scroll properties">
            {{ include('Property/_partial/template.html.twig') }}
        </div>
        <div class="modal" id="propertyModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="propertyModalTitle">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="propertyModalTitle"></h2>
                        <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer">
                        <div class="submit">
                            <button class="btn btn-success" onclick="formProperty();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                            {% if is_granted('PROPERTY_DELETE') %}
                                <button class="btn btn-danger" data-delete-confirm onclick="deleteProperty();">{{ 'confirm'|translateLocale|mbUcfirst }}</button>
                            {% endif %}
                            <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('returnMenu'), {content: "{{ 'return_to_main_menu'|translateLocale|mbUcfirst|e('js') }}"});
        {% if is_granted('ROLE_ADMIN') %}
            tippy(document.getElementById('launchCommandProperty'), {content: "{{ 'launch_the_properties_retrieval_command'|translateLocale|mbUcfirst|e('js') }}"});
            tippy(document.getElementById('stopCommandProperty'), {content: "{{ 'stop_the_properties_retrieval_command'|translateLocale|mbUcfirst|e('js') }}"});
        {% endif %}
        tippy(document.getElementById('addProperty'), {content: "{{ 'add_a_property'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('removeAllFilters'), {content: "{{ 'remove_all_filters'|translateLocale|mbUcfirst|e('js') }}"});

        let filterOwned;
        let filterWanted;
        let filterPropertyTypeId;
        let filterBusinessId;
        let filterPropertyAreaId;
        let filterPropertyLocationId;
        let filterTitleUpdateId;
        let filterCapacityVehicles;
        let filterCapacityBicycles;
        let filterPropertyAcquisitionIds;
        let filterSearch;
        let reloadTimerId;

        {% if is_granted('ROLE_ADMIN') %}
            if (document.getElementById('configuration-loader-property').classList.contains('is-visible')) {
                checkCommandProperty();
            }
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            function checkCommandProperty() {
                fetch('{{ path('check_command_property') }}')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        showAlert(false, data.message, data.error);
                    } else {
                        if (data.percentage !== "0") {
                            document.getElementById('launchCommandProperty').classList.remove('is-visible');
                            document.getElementById('configuration-loader-property').classList.add('is-visible');
                            document.getElementById('stopCommandProperty').classList.add('is-visible');
                            document.getElementById('configuration-loader-property__text').textContent = data.percentageFormatted;

                            setTimeout("checkCommandProperty();", 5000);
                        } else {
                            document.getElementById('stopCommandProperty').classList.remove('is-visible');
                            document.getElementById('configuration-loader-property').classList.remove('is-visible');
                            document.getElementById('launchCommandProperty').classList.add('is-visible');
                        }
                    }
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                });
            }

            function launchCommandProperty() {
                showLoader();

                postRequest('{{ path('launch_command_property') }}')
                .then(response => response.json())
                .then(data => {
                    showAlert(data.success, data.message);
                    checkCommandProperty();
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }

            function stopCommandProperty() {
                showLoader();

                postRequest('{{ path('stop_command_property') }}')
                .then(response => response.json())
                .then(data => {
                    showAlert(data.success, data.message);
                    checkCommandProperty();
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        function removeAllFilters() {
            showLoader();

            fetch('{{ path('filter_property') }}'
                + '?owned=null'
                + '&wanted=null'
                + '&propertyTypeId=0'
                + '&businessId=0'
                + '&propertyAreaId=0'
                + '&propertyLocationId=0'
                + '&titleUpdateId=0'
                + '&capacityVehicles=null'
                + '&capacityBicycles=null'
                + '&search='
                + '&page=' + {{ filter['page'] }}
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkProperties(data.properties);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function reloadFilter(urlOrder = '', page = null) {
            showLoader();

            let urlPropertyAcquisitionIds = '';
            let urlPage                   = (page !== null) ? '&page=' + page : '&page=' + {{ filter['page'] }};

            if (filterPropertyAcquisitionIds) {
                filterPropertyAcquisitionIds.tomselect.items.forEach(propertyAcquisitionId => {
                    urlPropertyAcquisitionIds += '&propertyAcquisitionIds[]=' + propertyAcquisitionId;
                });
            }

            fetch('{{ path('filter_property') }}'
                + '?owned=' + filterOwned.value
                + '&wanted=' + filterWanted.value
                + '&propertyTypeId=' + filterPropertyTypeId.value
                + '&businessId=' + filterBusinessId.value
                + '&propertyAreaId=' + filterPropertyAreaId.value
                + '&propertyLocationId=' + filterPropertyLocationId.value
                + '&titleUpdateId=' + filterTitleUpdateId.value
                + '&capacityVehicles=' + filterCapacityVehicles.value
                + '&capacityBicycles=' + filterCapacityBicycles.value
                + urlPropertyAcquisitionIds
                + '&search=' + encodeURIComponent(filterSearch.value)
                + urlPage
                + urlOrder
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkProperties(data.properties);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        checkFilter();
        checkProperties({{ properties|json_encode|raw }});

        function checkFilter() {
            filterOwned                  = document.getElementById('filterOwned');
            filterWanted                 = document.getElementById('filterWanted');
            filterPropertyTypeId         = document.getElementById('filterPropertyTypeId');
            filterBusinessId             = document.getElementById('filterBusinessId');
            filterPropertyAreaId         = document.getElementById('filterPropertyAreaId');
            filterPropertyLocationId     = document.getElementById('filterPropertyLocationId');
            filterTitleUpdateId          = document.getElementById('filterTitleUpdateId');
            filterCapacityVehicles       = document.getElementById('filterCapacityVehicles');
            filterCapacityBicycles       = document.getElementById('filterCapacityBicycles');
            filterPropertyAcquisitionIds = document.getElementById('filterPropertyAcquisitionIds');
            filterSearch                 = document.getElementById('filterSearch');
            reloadTimerId                = null;

            {% if is_granted('PROPERTY_OWN') %}
                new TomSelect("#filterOwned", {maxOptions: null});
                new TomSelect("#filterWanted", {maxOptions: null});
            {% endif %}
            new TomSelect("#filterPropertyTypeId", {maxOptions: null});
            new TomSelect("#filterBusinessId", {maxOptions: null});
            new TomSelect("#filterPropertyAreaId", {maxOptions: null});
            new TomSelect("#filterPropertyLocationId", {maxOptions: null});
            new TomSelect("#filterTitleUpdateId", {maxOptions: null});
            new TomSelect("#filterCapacityVehicles", {maxOptions: null});
            new TomSelect("#filterCapacityBicycles", {maxOptions: null});
            new TomSelect("#filterPropertyAcquisitionIds", {maxOptions: null, plugins: ['remove_button']});

            {% if is_granted('PROPERTY_OWN') %}
                filterOwned.addEventListener('change', () => {
                    reloadFilter();
                });
                filterWanted.addEventListener('change', () => {
                    reloadFilter();
                });
            {% endif %}
            filterPropertyTypeId.addEventListener('change', () => {
                reloadFilter();
            });
            filterBusinessId.addEventListener('change', () => {
                reloadFilter();
            });
            filterPropertyAreaId.addEventListener('change', () => {
                reloadFilter();
            });
            filterPropertyLocationId.addEventListener('change', () => {
                reloadFilter();
            });
            filterTitleUpdateId.addEventListener('change', () => {
                reloadFilter();
            });
            filterCapacityVehicles.addEventListener('change', () => {
                reloadFilter();
            });
            filterCapacityBicycles.addEventListener('change', () => {
                reloadFilter();
            });
            filterPropertyAcquisitionIds.addEventListener('change', () => {
                reloadFilter();
            });
            filterSearch.addEventListener("input", () => {
                clearTimeout(reloadTimerId);
                reloadTimerId = setTimeout(() => {
                    reloadFilter();
                }, 500);
            });
        }

        function checkProperties(properties) {
            document.querySelectorAll('div.table-scroll.properties [data-maximum-message]').forEach(cell => {
                tippy(cell, {content: cell.getAttribute('data-maximum-message')});
            });

            properties.forEach(property => {
                tippy(document.getElementById('formProperty_' + property.id), {content: '{{ 'edit_the_property'|translateLocale|mbUcfirst|e('js') }} "' + property.name + '"'});
                {% if is_granted('PROPERTY_DELETE') %}
                    tippy(document.getElementById('deleteProperty_' + property.id), {content: '{{ 'delete_the_property'|translateLocale|mbUcfirst|e('js') }} "' + property.name + '"'});
                {% endif %}

                if (property.webPath) {
                    const content = '<img src="' + escapeHtml(property.webPath) + '" alt="' + escapeHtml(property.name) + '" class="img-fluid" style="height: 154px; margin-top: 10px; width: 274px;" />';

                    tippy(document.getElementById('propertyName_' + property.id), {content: content, allowHTML: true});
                }

                if (property.comment) {
                    const content = '<strong>{{ 'comment'|translateLocale|mbUcfirst|colon|e('js') }} </strong><br/>' + escapeHtml(property.comment).replace(/\r?\n/g, '<br/>');

                    tippy(document.getElementById('svgInfo_' + property.id), {content: content, allowHTML: true});
                }
            });
        }

        function editProperty(propertyId, element = null) {
            showLoader();

            let owned  = document.getElementById('propertyOwned_' + propertyId);
            let wanted = document.getElementById('propertyWanted_' + propertyId);

            postRequest('{{ path('update_property') }}?propertyId=' + propertyId + '&owned=' + (owned.checked ? 1 : 0) + '&wanted=' + (wanted.checked ? 1 : 0))
            .then(response => response.json())
            .then(data => {
                if (data.success === true) {
                    refreshList(data);
                    checkFilter();
                    checkProperties(data.properties);
                } else if (element) {
                    element.checked = !element.checked;
                }
                showAlert(data.success, data.message);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function formProperty() {
            showLoader();

            let name                   = document.querySelector('#propertyModal').querySelector('input[name="name"]');
            let owned                  = document.querySelector('#propertyModal').querySelector('input[name="owned"]');
            let wanted                 = document.querySelector('#propertyModal').querySelector('input[name="wanted"]');
            let propertyTypeId         = document.querySelector('#propertyModal').querySelector('select[name="propertyTypeId"]');
            let businessId             = document.querySelector('#propertyModal').querySelector('select[name="businessId"]');
            let propertyAreaId         = document.querySelector('#propertyModal').querySelector('select[name="propertyAreaId"]');
            let propertyLocationId     = document.querySelector('#propertyModal').querySelector('select[name="propertyLocationId"]');
            let titleUpdateId          = document.querySelector('#propertyModal').querySelector('select[name="titleUpdateId"]');
            let price                  = document.querySelector('#propertyModal').querySelector('input[name="price"]');
            let discountedPrice        = document.querySelector('#propertyModal').querySelector('input[name="discountedPrice"]');
            let discountedPercentage   = document.querySelector('#propertyModal').querySelector('input[name="discountedPercentage"]');
            let capacityVehicles       = document.querySelector('#propertyModal').querySelector('input[name="capacityVehicles"]');
            let capacityBicycles       = document.querySelector('#propertyModal').querySelector('input[name="capacityBicycles"]');
            let url                    = document.querySelector('#propertyModal').querySelector('input[name="url"]');
            let propertyAcquisitionIds = document.querySelector('#propertyModal').querySelector('select[name="propertyAcquisitionIds[]"]');
            let propertyTwoIds         = document.querySelector('#propertyModal').querySelector('select[name="propertyTwoIds[]"]');
            let comment                = document.querySelector('#propertyModal').querySelector('textarea[name="comment"]');
            let propertyId             = document.querySelector('#propertyModal').querySelector('input[name="id"]');

            document.querySelector('#propertyModal').querySelector('#error_name').classList.remove('show');
            document.querySelector('#propertyModal').querySelector('#error_price').classList.remove('show');

            if (!name.value || !price.value) {
                if (!name.value) {
                    document.querySelector('#propertyModal').querySelector('#error_name').classList.add('show');
                }

                if (!price.value) {
                    document.querySelector('#propertyModal').querySelector('#error_price').classList.add('show');
                }

                hideLoader();
            } else {
                let urlPropertyAcquisitionIds = '';
                let urlPropertyTwoIds         = '';

                if (propertyAcquisitionIds) {
                    propertyAcquisitionIds.tomselect.items.forEach(propertyAcquisitionId => {
                        urlPropertyAcquisitionIds += '&propertyAcquisitionIds[]=' + propertyAcquisitionId;
                    });
                }

                if (propertyTwoIds) {
                    propertyTwoIds.tomselect.items.forEach(propertyTwoId => {
                        urlPropertyTwoIds += '&propertyTwoIds[]=' + propertyTwoId;
                    });
                }
                postRequest('{{ path('form_property') }}'
                    + '?name=' + encodeURIComponent(name.value)
                    + '&owned=' + (owned.checked ? 1 : 0)
                    + '&wanted=' + (wanted.checked ? 1 : 0)
                    + '&propertyTypeId=' + propertyTypeId.value
                    + '&businessId=' + businessId.value
                    + '&propertyAreaId=' + propertyAreaId.value
                    + '&propertyLocationId=' + propertyLocationId.value
                    + '&titleUpdateId=' + titleUpdateId.value
                    + '&price=' + price.value
                    + '&discountedPrice=' + discountedPrice.value
                    + '&discountedPercentage=' + discountedPercentage.value
                    + '&capacityVehicles=' + capacityVehicles.value
                    + '&capacityBicycles=' + capacityBicycles.value
                    + '&url=' + (url ? url.value : '')
                    + urlPropertyAcquisitionIds
                    + urlPropertyTwoIds
                    + '&comment=' + encodeURIComponent(comment.value)
                    + '&propertyId=' + propertyId.value
                )
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#propertyModal'));
                        refreshList(data);
                        checkFilter();
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        }

        function checkPropertyModal() {
            let modal          = document.querySelector('#propertyModal');
            let propertyTypeId = modal.querySelector('#propertyTypeId');
            let businessId     = modal.querySelector('#businessId');

            businessId.querySelectorAll('option').forEach((option) => {
                if (option.value) {
                    option.disabled = !option.selected && propertyTypeId.value !== ''
                                      && option.getAttribute('data-property-type-id') !== propertyTypeId.value;
                    syncTomSelectOption(businessId.tomselect, option);
                }
            });

            businessId.tomselect.refreshOptions(false);

            ['owned', 'wanted'].forEach((type) => {
                let checkbox  = modal.querySelector('#' + type);
                let formGroup = checkbox.closest('.form-group');
                let message   = (businessId.value ? businessId.selectedOptions[0].getAttribute('data-' + type + '-message') : '')
                                || checkbox.getAttribute('data-parent-message');

                if (formGroup._tippy) {
                    formGroup._tippy.destroy();
                }

                if (message) {
                    checkbox.checked  = false;
                    checkbox.disabled = true;
                    tippy(formGroup, {content: message});
                } else {
                    checkbox.disabled = false;
                }
            });
        }

        {% if is_granted('PROPERTY_DELETE') %}
            function deleteProperty() {
                showLoader();

                postRequest('{{ path('delete_property') }}?propertyId=' + document.querySelector('#propertyModal').querySelector('input[name="id"]').value)
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#propertyModal'));
                        refreshList(data);
                        checkFilter();
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        document.addEventListener("click", (event) => {
            const opener = event.target.closest("[data-modal-open]");

            if (!opener) return;

            showLoader();

            const id         = opener.getAttribute("data-property-id") ?? '';
            const modal      = document.querySelector(opener.getAttribute("data-modal-open"));
            const deleteMode = opener.hasAttribute("data-delete");

            openModal(modal);

            if (deleteMode) {
                modal.querySelector('#propertyModalTitle').textContent = '{{ 'delete_the_property'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-property-name") + '"';
            } else if (id) {
                modal.querySelector('#propertyModalTitle').textContent = '{{ 'edit_the_property'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-property-name") + '"';
            } else {
                modal.querySelector('#propertyModalTitle').textContent = '{{ 'add_a_property'|translateLocale|mbUcfirst|e('js') }}';
            }

            fetch('{{ path('get_property') }}?propertyId=' + id + (deleteMode ? '&delete=1' : ''))
            .then(response => response.json())
            .then(data => {
                modal.querySelector('.modal-body').innerHTML = data.template;
                new TomSelect("#propertyTypeId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#businessId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#propertyAreaId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#propertyLocationId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#titleUpdateId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#propertyAcquisitionIds", { maxOptions: null, plugins: ['remove_button'] });
                new TomSelect("#propertyTwoIds", { maxOptions: null, plugins: ['remove_button'] });

                modal.querySelector('#propertyTypeId').addEventListener('change', () => {
                    checkPropertyModal();
                });

                modal.querySelector('#businessId').addEventListener('change', () => {
                    checkPropertyModal();
                });

                checkPropertyModal();
                setDeleteMode(modal, deleteMode, data.deletable);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        });
    </script>
{% endblock %}
