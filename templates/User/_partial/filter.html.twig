<div class="filter" style="--filter-grow: 6;">
    <label class="form-label" for="filterGroupGtaId">{{ 'group'|translateLocale|mbUcfirst }} ({{ filterGroupGtaIds|length }})</label>
    <select id="filterGroupGtaId">
        <option value="0">{{ 'all'|translateLocale({gender: 'masculine'})|mbUcfirst }}</option>
        {% for filterGroupGtaId in filterGroupGtaIds %}
            <option value="{{ filterGroupGtaId.id }}"
                {% if filter.groupGtaId == filterGroupGtaId.id %} selected{% endif %}>{{ filterGroupGtaId.name ~ ' (' ~ filterGroupGtaId.numberUsers ~ ')' }}</option>
        {% endfor %}
    </select>
</div>
<div class="filter" style="--filter-grow: 5;">
    <label class="form-label" for="filterActive">{{ 'active'|translateLocale|mbUcfirst }} ({{ filterActives|length }})</label>
    <select id="filterActive">
        <option value="null"{% if filter.active is same as(null) %} selected{% endif %}>{{ 'all'|translateLocale({gender: 'masculine'})|mbUcfirst }}</option>
        {% for filterActive in filterActives %}
            <option value="{{ filterActive.active }}"
                {% if not filter.active is same as(null) and filter.active == filterActive.active %} selected{% endif %}>{{ (filterActive.active == 1 ? 'yes'|translateLocale|mbUcfirst : 'no'|translateLocale|mbUcfirst ) ~ ' (' ~ filterActive.numberUsers ~ ')' }}</option>
        {% endfor %}
    </select>
</div>
<div class="filter" style="--filter-grow: 6;">
    <label class="form-label" for="filterRole">{{ 'role'|translateLocale|mbUcfirst }} ({{ filterRoles|length }})</label>
    <select id="filterRole">
        <option value="0"{% if filter.role == "0" %} selected{% endif %}>{{ 'all'|translateLocale({gender: 'masculine'})|mbUcfirst }}</option>
        {% for filterRole in filterRoles %}
            <option value="{{ filterRole.roles|role|striptags }}"
                {% if filter.role == filterRole.roles|role|striptags %} selected{% endif %}>{{ filterRole.roles|role|striptags ~ ' (' ~ filterRole.numberUsers ~ ')' }}</option>
        {% endfor %}
    </select>
</div>
<div class="filter" style="--filter-grow: 83;">
    <label class="form-label" for="filterSearch">{{ 'search'|translateLocale|mbUcfirst }} ({{ 'independent_of_other_filters'|translateLocale }})</label>
    <input type="search" id="filterSearch" value="{{ filter.search }}" class="form-input" />
</div>
<div class="removeAllFilters">
    {% if filter.groupGtaId != 0 or filter.active is not same as(null) or filter.role != "0" or filter.search != "" %}
        <a onclick="removeAllFilters();" class="btn btn-danger" id="removeAllFilters">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path fill="#FFFFFF" d="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z" />
            </svg>
        </a>
    {% endif %}
</div>
