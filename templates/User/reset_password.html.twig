{% extends "layout.html.twig" %}

{% block title %}{{ 'password_reset'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="login content">
        <div class="elements">
            <div class="element">
                <div class="login-header">
                    <h1>GTA 5 Online</h1>
                    <p>{{ 'choose_your_new_password'|translateLocale|mbUcfirst }}</p>
                </div>
                <div class="form-group">
                    <label for="password">{{ 'new_password'|translateLocale|mbUcfirst }}</label>
                    <input type="password" class="form-control" id="password" autocomplete="new-password" autofocus />
                    <div class="error" id="error_password">{{ 'please_enter_a_valid_password'|translateLocale|mbUcfirst }} !</div>
                    <span class="help">{{ 'the_password_must_contain_at_least'|translateLocale({count: passwordMinLength})|mbUcfirst }}, {{ 'without_your_personal_information'|translateLocale }}.</span>
                </div>
                <div class="form-group">
                    <label for="passwordConfirmation">{{ 'password_confirmation'|translateLocale|mbUcfirst }}</label>
                    <input type="password" class="form-control" id="passwordConfirmation" autocomplete="new-password" />
                    <div class="error" id="error_passwordConfirmation">{{ 'the_passwords_are_not_identical'|translateLocale|mbUcfirst }} !</div>
                </div>
                <div class="submit">
                    <button type="button" class="btn btn-primary" onclick="resetPassword();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                </div>
                <div class="login-links">
                    <a href="{{ path('login') }}">{{ 'back_to_the_login'|translateLocale|mbUcfirst }}</a>
                </div>
            </div>
        </div>
    </div>
    {{ include('_partial/alert.html.twig') }}
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        function resetPassword() {
            const password             = document.getElementById('password');
            const passwordConfirmation = document.getElementById('passwordConfirmation');
            const validPassword        = isValidPassword(password.value);
            const identical            = password.value === passwordConfirmation.value;

            document.getElementById('error_password').classList.toggle('show', !validPassword);
            document.getElementById('error_passwordConfirmation').classList.toggle('show', validPassword && !identical);

            if (!validPassword || !identical) {
                return;
            }

            showLoader();

            postRequest('{{ path('check_reset_password_user') }}'
                + '?userId={{ userId }}'
                + '&code={{ code }}'
                + '&password=' + encodeURIComponent(password.value)
                + '&passwordConfirmation=' + encodeURIComponent(passwordConfirmation.value)
            )
            .then(response => response.json())
            .then(data => {
                if (data.success === true) {
                    window.location.href = data.redirect;

                    return;
                }
                showAlert(false, data.message);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }
    </script>
{% endblock %}
