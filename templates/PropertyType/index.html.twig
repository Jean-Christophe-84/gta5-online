{% extends "layout.html.twig" %}

{% block title %}{{ 'property_types'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content">
        {{ include('_partial/alert.html.twig') }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
        </div>
        <div class="include filters">
            {{ include('PropertyType/_partial/filter.html.twig') }}
        </div>
        {% if is_granted('PROPERTY_TYPE_ADD') %}
            <div class="addPropertyType" id="addPropertyType">
                <button class="btn btn-primary" data-modal-open="#propertyTypeModal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                    </svg>
                </button>
            </div>
        {% endif %}
        <div class="table-scroll propertyTypes">
            {{ include('PropertyType/_partial/template.html.twig') }}
        </div>
        <div class="modal" id="propertyTypeModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="propertyTypeModalTitle">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="propertyTypeModalTitle"></h2>
                        <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer">
                        <div class="submit">
                            <button class="btn btn-success" onclick="formPropertyType();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                            {% if is_granted('PROPERTY_TYPE_DELETE') %}
                                <button class="btn btn-danger" data-delete-confirm onclick="deletePropertyType();">{{ 'confirm'|translateLocale|mbUcfirst }}</button>
                            {% endif %}
                            <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('returnMenu'), {content: "{{ 'return_to_main_menu'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('addPropertyType'), {content: "{{ 'add_a_property_type'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('removeAllFilters'), {content: "{{ 'remove_all_filters'|translateLocale|mbUcfirst|e('js') }}"});

        let filterStorageLocationIds;
        let filterSearch;
        let reloadTimerId;

        function removeAllFilters() {
            showLoader();

            fetch('{{ path('filter_property-type') }}?search=&page=' + {{ filter['page'] }})
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkPropertyTypes(data.propertyTypes);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function reloadFilter(urlOrder = '', page = null) {
            showLoader();

            let urlStorageLocationIds = '';
            let urlPage               = (page !== null) ? '&page=' + page : '&page=' + {{ filter['page'] }};

            if (filterStorageLocationIds) {
                filterStorageLocationIds.tomselect.items.forEach(storageLocationId => {
                    urlStorageLocationIds += '&storageLocationIds[]=' + storageLocationId;
                });
            }

            fetch('{{ path('filter_property-type') }}?search=' + encodeURIComponent(filterSearch.value) + urlStorageLocationIds + urlPage + urlOrder)
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkPropertyTypes(data.propertyTypes);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        checkFilter();
        checkPropertyTypes({{ propertyTypes|json_encode|raw }});

        function checkFilter() {
            filterStorageLocationIds = document.getElementById('filterStorageLocationIds');
            filterSearch             = document.getElementById('filterSearch');
            reloadTimerId            = null;

            new TomSelect("#filterStorageLocationIds", { maxOptions: null, plugins: ['remove_button'] });

            filterStorageLocationIds.addEventListener('change', () => {
                reloadFilter();
            });
            filterSearch.addEventListener("input", () => {
                clearTimeout(reloadTimerId);
                reloadTimerId = setTimeout(() => {
                    reloadFilter();
                }, 500);
            });
        }

        function checkPropertyTypes(propertyTypes) {
            propertyTypes.forEach(propertyType => {
                tippy(document.getElementById('formPropertyType_' + propertyType.id), {content: '{{ 'edit_the_property_type'|translateLocale|mbUcfirst|e('js') }} "' + propertyType.name + '"'});
                {% if is_granted('PROPERTY_TYPE_DELETE') %}
                    tippy(document.getElementById('deletePropertyType_' + propertyType.id), {content: '{{ 'delete_the_property_type'|translateLocale|mbUcfirst|e('js') }} "' + propertyType.name + '"'});
                {% endif %}
            });
        }

        function formPropertyType() {
            showLoader();

            let name               = document.querySelector('#propertyTypeModal').querySelector('input[name="name"]');
            let storageLocationIds = document.querySelector('#propertyTypeModal').querySelector('select[name="storageLocationIds[]"]');
            let propertyTypeId     = document.querySelector('#propertyTypeModal').querySelector('input[name="id"]');

            document.querySelector('#propertyTypeModal').querySelector('#error_name').classList.remove('show');

            if (!name.value) {
                document.querySelector('#propertyTypeModal').querySelector('#error_name').classList.add('show');

                hideLoader();
            } else {
                let urlStorageLocationIds = '';

                if (storageLocationIds) {
                    storageLocationIds.tomselect.items.forEach(storageLocationId => {
                        urlStorageLocationIds += '&storageLocationIds[]=' + storageLocationId;
                    });
                }
                postRequest('{{ path('form_property-type') }}'
                    + '?name=' + encodeURIComponent(name.value)
                    + urlStorageLocationIds
                    + '&propertyTypeId=' + propertyTypeId.value
                )
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#propertyTypeModal'));
                        refreshList(data);
                        checkFilter();
                        checkPropertyTypes(data.propertyTypes);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        }

        {% if is_granted('PROPERTY_TYPE_DELETE') %}
            function deletePropertyType() {
                showLoader();

                postRequest('{{ path('delete_property-type') }}?propertyTypeId=' + document.querySelector('#propertyTypeModal').querySelector('input[name="id"]').value)
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#propertyTypeModal'));
                        refreshList(data);
                        checkFilter();
                        checkPropertyTypes(data.propertyTypes);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        document.addEventListener("click", (event) => {
            const opener = event.target.closest("[data-modal-open]");

            if (!opener) return;

            showLoader();

            const id         = opener.getAttribute("data-property-type-id") ?? '';
            const modal      = document.querySelector(opener.getAttribute("data-modal-open"));
            const deleteMode = opener.hasAttribute("data-delete");

            openModal(modal);

            if (deleteMode) {
                modal.querySelector('#propertyTypeModalTitle').textContent = '{{ 'delete_the_property_type'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-property-type-name") + '"';
            } else if (id) {
                modal.querySelector('#propertyTypeModalTitle').textContent = '{{ 'edit_the_property_type'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-property-type-name") + '"';
            } else {
                modal.querySelector('#propertyTypeModalTitle').textContent = '{{ 'add_a_property_type'|translateLocale|mbUcfirst|e('js') }}';
            }

            fetch('{{ path('get_property-type') }}?propertyTypeId=' + id + (deleteMode ? '&delete=1' : ''))
            .then(response => response.json())
            .then(data => {
                modal.querySelector('.modal-body').innerHTML = data.template;
                new TomSelect("#storageLocationIds", { maxOptions: null, plugins: ['remove_button'] });
                setDeleteMode(modal, deleteMode, data.deletable);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        });
    </script>
{% endblock %}
