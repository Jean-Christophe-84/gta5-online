<div class="group">
    <div class="form-group" style="--filter-width: 30%;">
        <label class="form-label required" for="name">{{ 'name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="name" id="name"{% if propertyType and propertyType.name %} value="{{ propertyType.name }}"{% endif %} class="form-input" />
        <div class="error" id="error_name">{{ 'please_enter_the_name'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 70%;">
        {% set storageLocationIds = [] %}
        {% if propertyType %}
            {% if propertyType.storageLocationIds is not null %}
                {% set storageLocationIds = propertyType.storageLocationIds|split('+') %}
            {% endif %}
        {% endif %}
        <label class="form-label" for="storageLocationIds">{{ 'storage_location'|translateLocale|mbUcfirst }}</label>
        <select name="storageLocationIds[]" id="storageLocationIds" multiple data-multi-select>
            {% if storageLocationLocales is not empty %}
                {% for storageLocationLocale in storageLocationLocales %}
                    <option value="{{ storageLocationLocale.storageLocation.id }}"
                        {% if storageLocationLocale.storageLocation.id in storageLocationIds %} selected{% endif %}>{{ storageLocationLocale.name }}</option>
                {% endfor %}
            {% endif %}
        </select>
    </div>
    <input type="hidden" name="id" value="{{ propertyType ? propertyType.id : '' }}">
</div>
