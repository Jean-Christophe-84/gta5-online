{% extends "layout.html.twig" %}

{% block title %}{{ 'bail_office'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content">
        {{ include('_partial/alert.html.twig') }}
        {{ include('_partial/tips.html.twig', {tips: tips('bounty_targets')}) }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
        </div>
        <div class="include filters">
            {{ include('BountyTarget/_partial/filter.html.twig') }}
        </div>
        {% if is_granted('BOUNTY_TARGET_ADD') %}
            <div class="addBountyTarget" id="addBountyTarget">
                <button class="btn btn-primary" data-modal-open="#bountyTargetModal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                    </svg>
                </button>
            </div>
        {% endif %}
        {% if is_granted('BOUNTY_TARGET_DONE') %}
            <div class="include summary">
                {{ include('_partial/summary.html.twig', {entity: 'bounty_targets'}) }}
            </div>
        {% endif %}
        <div class="table-scroll bountyTargets">
            {{ include('BountyTarget/_partial/template.html.twig') }}
        </div>
        <div class="modal" id="bountyTargetModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="bountyTargetModalTitle">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="bountyTargetModalTitle"></h2>
                        <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer">
                        <div class="submit">
                            <button class="btn btn-success" onclick="formBountyTarget();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                            {% if is_granted('BOUNTY_TARGET_DELETE') %}
                                <button class="btn btn-danger" data-delete-confirm onclick="deleteBountyTarget();">{{ 'confirm'|translateLocale|mbUcfirst }}</button>
                            {% endif %}
                            <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('returnMenu'), {content: "{{ 'return_to_main_menu'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('addBountyTarget'), {content: "{{ 'add_a_bounty_target'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('removeAllFilters'), {content: "{{ 'remove_all_filters'|translateLocale|mbUcfirst|e('js') }}"});

        let filterSearch;
        let reloadTimerId;

        function removeAllFilters() {
            showLoader();

            fetch('{{ path('filter_bounty-target') }}?search=&page=' + {{ filter['page'] }})
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkBountyTargets(data.bountyTargets);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function reloadFilter(urlOrder = '', page = null) {
            showLoader();

            let urlPage = (page !== null) ? '&page=' + page : '&page=' + {{ filter['page'] }};

            fetch('{{ path('filter_bounty-target') }}?search=' + encodeURIComponent(filterSearch.value) + urlPage + urlOrder)
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkBountyTargets(data.bountyTargets);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        checkFilter();
        checkBountyTargets({{ bountyTargets|json_encode|raw }});

        function checkFilter() {
            filterSearch  = document.getElementById('filterSearch');
            reloadTimerId = null;

            filterSearch.addEventListener("input", () => {
                clearTimeout(reloadTimerId);
                reloadTimerId = setTimeout(() => {
                    reloadFilter();
                }, 500);
            });
        }

        function checkBountyTargets(bountyTargets) {
            bountyTargets.forEach(bountyTarget => {
                tippy(document.getElementById('formBountyTarget_' + bountyTarget.id), {content: '{{ 'edit_the_bounty_target'|translateLocale|mbUcfirst|e('js') }} "' + bountyTarget.name + '"'});
                {% if is_granted('BOUNTY_TARGET_DELETE') %}
                    tippy(document.getElementById('deleteBountyTarget_' + bountyTarget.id), {content: '{{ 'delete_the_bounty_target'|translateLocale|mbUcfirst|e('js') }} "' + bountyTarget.name + '"'});
                {% endif %}
            });
        }

        {% if is_granted('BOUNTY_TARGET_DONE') %}
            function editBountyTarget(bountyTargetId) {
                showLoader();

                let done = document.getElementById('bountyTargetDone_' + bountyTargetId);

                postRequest('{{ path('update_bounty-target') }}?bountyTargetId=' + bountyTargetId + '&done=' + (done.checked ? 1 : 0))
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        refreshList(data);
                        checkFilter();
                        checkBountyTargets(data.bountyTargets);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        function formBountyTarget() {
            showLoader();

            let name            = document.querySelector('#bountyTargetModal').querySelector('input[name="name"]');
            let bountyMissionId = document.querySelector('#bountyTargetModal').querySelector('select[name="bountyMissionId"]');
            let mostWanted      = document.querySelector('#bountyTargetModal').querySelector('input[name="mostWanted"]');
            let done            = document.querySelector('#bountyTargetModal').querySelector('input[name="done"]');
            let bountyTargetId  = document.querySelector('#bountyTargetModal').querySelector('input[name="id"]');

            document.querySelector('#bountyTargetModal').querySelector('#error_name').classList.remove('show');

            if (!name.value) {
                document.querySelector('#bountyTargetModal').querySelector('#error_name').classList.add('show');

                hideLoader();
            } else {
                postRequest('{{ path('form_bounty-target') }}'
                    + '?name=' + encodeURIComponent(name.value)
                    + '&bountyMissionId=' + bountyMissionId.value
                    + '&mostWanted=' + (mostWanted.checked ? 1 : 0)
                    + '&done=' + (done && done.checked ? 1 : 0)
                    + '&bountyTargetId=' + bountyTargetId.value
                )
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#bountyTargetModal'));
                        refreshList(data);
                        checkFilter();
                        checkBountyTargets(data.bountyTargets);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        }

        {% if is_granted('BOUNTY_TARGET_DELETE') %}
            function deleteBountyTarget() {
                showLoader();

                postRequest('{{ path('delete_bounty-target') }}?bountyTargetId=' + document.querySelector('#bountyTargetModal').querySelector('input[name="id"]').value)
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#bountyTargetModal'));
                        refreshList(data);
                        checkFilter();
                        checkBountyTargets(data.bountyTargets);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        document.addEventListener("click", (event) => {
            const opener = event.target.closest("[data-modal-open]");

            if (!opener) return;

            showLoader();

            const id         = opener.getAttribute("data-bounty-target-id") ?? '';
            const modal      = document.querySelector(opener.getAttribute("data-modal-open"));
            const deleteMode = opener.hasAttribute("data-delete");

            openModal(modal);

            if (deleteMode) {
                modal.querySelector('#bountyTargetModalTitle').textContent = '{{ 'delete_the_bounty_target'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-bounty-target-name") + '"';
            } else if (id) {
                modal.querySelector('#bountyTargetModalTitle').textContent = '{{ 'edit_the_bounty_target'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-bounty-target-name") + '"';
            } else {
                modal.querySelector('#bountyTargetModalTitle').textContent = '{{ 'add_a_bounty_target'|translateLocale|mbUcfirst|e('js') }}';
            }

            fetch('{{ path('get_bounty-target') }}?bountyTargetId=' + id + (deleteMode ? '&delete=1' : ''))
            .then(response => response.json())
            .then(data => {
                modal.querySelector('.modal-body').innerHTML = data.template;
                new TomSelect("#bountyMissionId", { allowEmptyOption: true, maxOptions: null });
                setDeleteMode(modal, deleteMode, data.deletable);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        });
    </script>
{% endblock %}
