<table class="bountyTargets">
    <thead>
        <tr>
            <th role="button" data-sort-key="bounty_target-name" onclick="orderFilter(this, event);"
                {% if filter['order']['bounty_target-name'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['bounty_target-name']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'name'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="bounty_mission_locale-name" onclick="orderFilter(this, event);"
                {% if filter['order']['bounty_mission_locale-name'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['bounty_mission_locale-name']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'bounty_mission'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            <th role="button" data-sort-key="bounty_target-most_wanted" onclick="orderFilter(this, event);"
                {% if filter['order']['bounty_target-most_wanted'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['bounty_target-most_wanted']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'most_wanted'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
            {% if is_granted('BOUNTY_TARGET_DONE') %}
                <th role="button" data-sort-key="bounty_target_user-done" onclick="orderFilter(this, event);"
                    {% if filter['order']['bounty_target_user-done'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['bounty_target_user-done']|lower }}"{% endif %}>
                    <div class="cell"><label>{{ 'done'|translateLocale|mbUcfirst }}</label></div>
                    {{ include('_partial/arrows.html.twig') }}
                </th>
            {% endif %}
            <th role="button" data-sort-key="bounty_target-price" onclick="orderFilter(this, event);"
                {% if filter['order']['bounty_target-price'] is defined %} class="is-sorted" data-sort-dir="{{ filter['order']['bounty_target-price']|lower }}"{% endif %}>
                <div class="cell"><label>{{ 'reward_alive'|translateLocale|mbUcfirst }}</label></div>
                {{ include('_partial/arrows.html.twig') }}
            </th>
        </tr>
    </thead>
    <tbody>
        {% for bountyTarget in bountyTargets %}
            <tr id="bountyTarget_{{ bountyTarget.id }}"{% if bountyTarget.mostWanted %} class="mostWanted"{% endif %}>
                <td data-sort-value="{{ bountyTarget.name }}" class="name"><div class="cell">{{ bountyTarget.name }}</div>
                    {% if is_granted('BOUNTY_TARGET_EDIT') %}
                        <button class="btn btn-warning" data-modal-open="#bountyTargetModal" data-bounty-target-id="{{ bountyTarget.id }}"
                                data-bounty-target-name="{{ bountyTarget.name }}" id="formBountyTarget_{{ bountyTarget.id }}">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#FFFFFF" d="M100.4 417.2C104.5 402.6 112.2 389.3 123 378.5L304.2 197.3L338.1 163.4C354.7 180 389.4 214.7 442.1 267.4L476 301.3L442.1 335.2L260.9 516.4C250.2 527.1 236.8 534.9 222.2 539L94.4 574.6C86.1 576.9 77.1 574.6 71 568.4C64.9 562.2 62.6 553.3 64.9 545L100.4 417.2zM156 413.5C151.6 418.2 148.4 423.9 146.7 430.1L122.6 517L209.5 492.9C215.9 491.1 221.7 487.8 226.5 483.2L155.9 413.5zM510 267.4C493.4 250.8 458.7 216.1 406 163.4L372 129.5C398.5 103 413.4 88.1 416.9 84.6C430.4 71 448.8 63.4 468 63.4C487.2 63.4 505.6 71 519.1 84.6L554.8 120.3C568.4 133.9 576 152.3 576 171.4C576 190.5 568.4 209 554.8 222.5C551.3 226 536.4 240.9 509.9 267.4z" />
                            </svg>
                        </button>
                    {% endif %}
                    {% if is_granted('BOUNTY_TARGET_DELETE') %}
                        <button class="btn btn-danger" data-modal-open="#bountyTargetModal" data-delete data-bounty-target-id="{{ bountyTarget.id }}"
                                data-bounty-target-name="{{ bountyTarget.name }}" id="deleteBountyTarget_{{ bountyTarget.id }}">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#FFFFFF" d="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z" />
                            </svg>
                        </button>
                    {% endif %}
                </td>
                <td data-sort-value="{{ bountyTarget.bountyMissionName }}" class="bountyMissionName"><div class="cell">{{ bountyTarget.bountyMissionName }}</div></td>
                <td data-sort-value="{{ bountyTarget.mostWanted ? 1 : 0 }}" class="mostWanted key">
                    <div class="cell">
                        {% if bountyTarget.mostWanted %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#008800" d="M530.8 134.1C545.1 144.5 548.3 164.5 537.9 178.8L281.9 530.8C276.4 538.4 267.9 543.1 258.5 543.9C249.1 544.7 240 541.2 233.4 534.6L105.4 406.6C92.9 394.1 92.9 373.8 105.4 361.3C117.9 348.8 138.2 348.8 150.7 361.3L252.2 462.8L486.2 141.1C496.6 126.8 516.6 123.6 530.9 134z" />
                            </svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                                <path fill="#ff0000" d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
                            </svg>
                        {% endif %}
                    </div>
                </td>
                {% if is_granted('BOUNTY_TARGET_DONE') %}
                    <td data-sort-value="{{ bountyTarget.done ? 1 : 0 }}" class="done key">
                        <div class="cell">
                            <div class="checkbox-wrapper-2">
                                <input type="checkbox" value="1"{% if bountyTarget.done %} checked{% endif %} class="stylized" id="bountyTargetDone_{{ bountyTarget.id }}"
                                       onchange="editBountyTarget({{ bountyTarget.id }});" />
                            </div>
                        </div>
                    </td>
                {% endif %}
                <td data-sort-value="{{ bountyTarget.priceMin }}" class="price key">
                    <div class="cell">{{ bountyTarget.priceMin|formatMoney }} – {{ bountyTarget.priceMax|formatMoney }}</div>
                </td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th>
                <div class="pagination">
                    {{ include('Widget/pagination.html.twig') }}
                </div>
            </th>
        </tr>
    </tfoot>
</table>
