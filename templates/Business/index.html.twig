{% extends "layout.html.twig" %}

{% block title %}{{ 'businesses'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content">
        {{ include('_partial/alert.html.twig') }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
        </div>
        <div class="include filters">
            {{ include('Business/_partial/filter.html.twig') }}
        </div>
        {% if is_granted('BUSINESS_ADD') %}
            <div class="addBusiness" id="addBusiness">
                <button class="btn btn-primary" data-modal-open="#businessModal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#FFFFFF" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                    </svg>
                </button>
            </div>
        {% endif %}
        <div class="table-scroll businesses">
            {{ include('Business/_partial/template.html.twig') }}
        </div>
        <div class="modal" id="businessModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="businessModalTitle">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="businessModalTitle"></h2>
                        <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer">
                        <div class="submit">
                            <button class="btn btn-success" onclick="formBusiness();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                            {% if is_granted('BUSINESS_DELETE') %}
                                <button class="btn btn-danger" data-delete-confirm onclick="deleteBusiness();">{{ 'confirm'|translateLocale|mbUcfirst }}</button>
                            {% endif %}
                            <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('returnMenu'), {content: "{{ 'return_to_main_menu'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('addBusiness'), {content: "{{ 'add_a_business'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('removeAllFilters'), {content: "{{ 'remove_all_filters'|translateLocale|mbUcfirst|e('js') }}"});

        let filterPropertyTypeId;
        let filterTitleUpdateId;
        let filterSearch;
        let reloadTimerId;

        function removeAllFilters() {
            showLoader();

            fetch('{{ path('filter_business') }}?propertyTypeId=0&titleUpdateId=0&search=&page=' + {{ filter['page'] }})
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkBusinesses(data.businesses);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function reloadFilter(urlOrder = '', page = null) {
            showLoader();

            let urlPage = (page !== null) ? '&page=' + page : '&page=' + {{ filter['page'] }};

            fetch('{{ path('filter_business') }}'
                + '?propertyTypeId=' + filterPropertyTypeId.value
                + '&titleUpdateId=' + filterTitleUpdateId.value
                + '&search=' + encodeURIComponent(filterSearch.value)
                + urlPage
                + urlOrder
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkBusinesses(data.businesses);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        checkFilter();
        checkBusinesses({{ businesses|json_encode|raw }});

        function checkFilter() {
            filterPropertyTypeId = document.getElementById('filterPropertyTypeId');
            filterTitleUpdateId  = document.getElementById('filterTitleUpdateId');
            filterSearch         = document.getElementById('filterSearch');
            reloadTimerId        = null;

            new TomSelect("#filterPropertyTypeId", { maxOptions: null });
            new TomSelect("#filterTitleUpdateId", { maxOptions: null });

            filterPropertyTypeId.addEventListener('change', () => {
                reloadFilter();
            });
            filterTitleUpdateId.addEventListener('change', () => {
                reloadFilter();
            });
            filterSearch.addEventListener("input", () => {
                clearTimeout(reloadTimerId);
                reloadTimerId = setTimeout(() => {
                    reloadFilter();
                }, 500);
            });
        }

        function checkBusinesses(businesses) {
            businesses.forEach(business => {
                tippy(document.getElementById('formBusiness_' + business.id), {content: '{{ 'edit_the_business'|translateLocale|mbUcfirst|e('js') }} "' + business.name + '"'});
                {% if is_granted('BUSINESS_DELETE') %}
                    tippy(document.getElementById('deleteBusiness_' + business.id), {content: '{{ 'delete_the_business'|translateLocale|mbUcfirst|e('js') }} "' + business.name + '"'});
                {% endif %}
            });
        }

        function formBusiness() {
            showLoader();

            let name           = document.querySelector('#businessModal').querySelector('input[name="name"]');
            let propertyTypeId = document.querySelector('#businessModal').querySelector('select[name="propertyTypeId"]');
            let contact        = document.querySelector('#businessModal').querySelector('input[name="contact"]');
            let maximumNumber  = document.querySelector('#businessModal').querySelector('input[name="maximumNumber"]');
            let titleUpdateId  = document.querySelector('#businessModal').querySelector('select[name="titleUpdateId"]');
            let dailyEarnings  = document.querySelector('#businessModal').querySelector('textarea[name="dailyEarnings"]');
            let dailyExpenses  = document.querySelector('#businessModal').querySelector('textarea[name="dailyExpenses"]');
            let improvement    = document.querySelector('#businessModal').querySelector('textarea[name="improvement"]');
            let businessId     = document.querySelector('#businessModal').querySelector('input[name="id"]');

            if (!name.value || !propertyTypeId.value || !maximumNumber.value || !titleUpdateId.value) {
                if (!name.value) {
                    document.querySelector('#businessModal').querySelector('#error_name').classList.add('show');
                }

                if (!propertyTypeId.value) {
                    document.querySelector('#businessModal').querySelector('#error_propertyTypeId').classList.add('show');
                }

                if (!maximumNumber.value) {
                    document.querySelector('#businessModal').querySelector('#error_maximumNumber').classList.add('show');
                }

                if (!titleUpdateId.value) {
                    document.querySelector('#businessModal').querySelector('#error_titleUpdateId').classList.add('show');
                }

                hideLoader();
            } else {
                postRequest('{{ path('form_business') }}'
                    + '?name=' + encodeURIComponent(name.value)
                    + '&propertyTypeId=' + propertyTypeId.value
                    + '&contact=' + contact.value
                    + '&maximumNumber=' + maximumNumber.value
                    + '&titleUpdateId=' + titleUpdateId.value
                    + '&dailyEarnings=' + encodeURIComponent(dailyEarnings.value)
                    + '&dailyExpenses=' + encodeURIComponent(dailyExpenses.value)
                    + '&improvement=' + encodeURIComponent(improvement.value)
                    + '&businessId=' + businessId.value
                )
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#businessModal'));
                        refreshList(data);
                        checkFilter();
                        checkBusinesses(data.businesses);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        }

        {% if is_granted('BUSINESS_DELETE') %}
            function deleteBusiness() {
                showLoader();

                postRequest('{{ path('delete_business') }}?businessId=' + document.querySelector('#businessModal').querySelector('input[name="id"]').value)
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#businessModal'));
                        refreshList(data);
                        checkFilter();
                        checkBusinesses(data.businesses);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        {% endif %}

        document.addEventListener("click", (event) => {
            const opener = event.target.closest("[data-modal-open]");

            if (!opener) return;

            showLoader();

            const id         = opener.getAttribute("data-business-id") ?? '';
            const modal      = document.querySelector(opener.getAttribute("data-modal-open"));
            const deleteMode = opener.hasAttribute("data-delete");

            openModal(modal);

            if (deleteMode) {
                modal.querySelector('#businessModalTitle').textContent = '{{ 'delete_the_business'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-business-name") + '"';
            } else if (id) {
                modal.querySelector('#businessModalTitle').textContent = '{{ 'edit_the_business'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-business-name") + '"';
            } else {
                modal.querySelector('#businessModalTitle').textContent = '{{ 'add_a_business'|translateLocale|mbUcfirst|e('js') }}';
            }

            fetch('{{ path('get_business') }}?businessId=' + id + (deleteMode ? '&delete=1' : ''))
            .then(response => response.json())
            .then(data => {
                modal.querySelector('.modal-body').innerHTML = data.template;
                new TomSelect("#propertyTypeId", { allowEmptyOption: true, maxOptions: null });
                new TomSelect("#titleUpdateId", { allowEmptyOption: true, maxOptions: null });
                setDeleteMode(modal, deleteMode, data.deletable);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        });
    </script>
{% endblock %}
