{% extends "layout.html.twig" %}

{% block title %}{{ 'groups'|translateLocale|mbUcfirst }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="content">
        {{ include('_partial/alert.html.twig') }}
        <div class="return">
            <a href="{{ path('homepage') }}" class="btn btn-primary" id="returnMenu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z" />
                </svg>
            </a>
        </div>
        <div class="include filters">
            {{ include('GroupGta/_partial/filter.html.twig') }}
        </div>
        <div class="addGroupGta" id="addGroupGta">
            <button class="btn btn-primary" data-modal-open="#groupGtaModal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path fill="#FFFFFF" d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                </svg>
            </button>
        </div>
        <div class="table-scroll groupGtas">
            {{ include('GroupGta/_partial/template.html.twig') }}
        </div>
        <div class="modal" id="groupGtaModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="groupGtaModalTitle">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="groupGtaModalTitle"></h2>
                        <button type="button" class="btn-close" aria-label="{{ 'close'|translateLocale|mbUcfirst }}" data-modal-close></button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer">
                        <div class="submit">
                            <button class="btn btn-success" onclick="formGroupGta();">{{ 'validate'|translateLocale|mbUcfirst }}</button>
                            <button class="btn btn-secondary" data-modal-close>{{ 'cancel'|translateLocale|mbUcfirst }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        tippy(document.getElementById('returnMenu'), {content: "{{ 'return_to_main_menu'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('addGroupGta'), {content: "{{ 'add_a_group'|translateLocale|mbUcfirst|e('js') }}"});
        tippy(document.getElementById('removeAllFilters'), {content: "{{ 'remove_all_filters'|translateLocale|mbUcfirst|e('js') }}"});

        let filterSearch;
        let reloadTimerId;

        function removeAllFilters() {
            showLoader();

            fetch('{{ path('filter_group-gta') }}'
                + '?search='
                + '&page=' + {{ filter['page'] }}
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkGroups(data.groupGtas);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        function reloadFilter(urlOrder = '', page = null) {
            showLoader();

            let urlPage = (page !== null) ? '&page=' + page : '&page=' + {{ filter['page'] }};

            fetch('{{ path('filter_group-gta') }}'
                + '?search=' + filterSearch.value
                + urlPage
                + urlOrder
            )
            .then(response => response.json())
            .then(data => {
                refreshList(data);
                checkFilter();
                checkGroups(data.groupGtas);
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        }

        checkFilter();
        checkGroups({{ groupGtas|json_encode|raw }});

        function checkFilter() {
            filterSearch = document.getElementById('filterSearch');

            filterSearch.addEventListener("input", () => {
                clearTimeout(reloadTimerId);
                reloadTimerId = setTimeout(() => {
                    reloadFilter();
                }, 500);
            });
        }

        function checkGroups(groups) {
            groups.forEach(group => {
                tippy(document.getElementById('formGroupGta_' + group.id), {content: '{{ 'edit_the_group'|translateLocale|mbUcfirst|e('js') }} "' + group.name + '"'});
            });
        }

        function formGroupGta() {
            showLoader();

            let name        = document.querySelector('#groupGtaModal').querySelector('input[name="name"]');
            let description = document.querySelector('#groupGtaModal').querySelector('textarea[name="description"]');
            let isDefault   = document.querySelector('#groupGtaModal').querySelector('input[name="default"]');
            let groupGtaId  = document.querySelector('#groupGtaModal').querySelector('input[name="id"]');

            document.querySelector('#groupGtaModal').querySelector('#error_name').classList.remove('show');
            document.querySelector('#groupGtaModal').querySelector('#error_description').classList.remove('show');

            if (!name.value || !description.value) {
                if (!name.value) {
                    document.querySelector('#groupGtaModal').querySelector('#error_name').classList.add('show');
                }

                if (!description.value) {
                    document.querySelector('#groupGtaModal').querySelector('#error_description').classList.add('show');
                }

                hideLoader();
            } else {
                postRequest('{{ path('form_group-gta') }}'
                    + '?name=' + encodeURIComponent(name.value)
                    + '&description=' + encodeURIComponent(description.value)
                    + '&default=' + (isDefault.checked ? 1 : 0)
                    + '&groupGtaId=' + groupGtaId.value
                    + '&permissionIds[]=' + [...document.querySelectorAll('#groupGtaModal input[name="permissionIds[]"]:checked')].map(input => '&permissionIds[]=' + input.value).join('')
                )
                .then(response => response.json())
                .then(data => {
                    if (data.success === true) {
                        closeModal(document.querySelector('#groupGtaModal'));
                        refreshList(data);
                        checkFilter();
                        checkGroups(data.groupGtas);
                    }
                    showAlert(data.success, data.message);
                })
                .catch((error) => {
                    console.error(error);
                    showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
                })
                .finally(() => {
                    hideLoader();
                });
            }
        }

        document.addEventListener("click", (event) => {
            const opener = event.target.closest("[data-modal-open]");

            if (!opener) return;

            showLoader();

            const id    = opener.getAttribute("data-group-gta-id") ?? '';
            const modal = document.querySelector(opener.getAttribute("data-modal-open"));

            openModal(modal);

            if (id) {
                modal.querySelector('#groupGtaModalTitle').textContent = '{{ 'edit_the_group'|translateLocale|mbUcfirst|e('js') }} "' + opener.getAttribute("data-group-gta-name") + '"';
            } else {
                modal.querySelector('#groupGtaModalTitle').textContent = '{{ 'add_a_group'|translateLocale|mbUcfirst|e('js') }}';
            }

            fetch('{{ path('get_group-gta') }}?groupGtaId=' + id)
            .then(response => response.json())
            .then(data => {
                modal.querySelector('.modal-body').innerHTML = data.template;
            })
            .catch((error) => {
                console.error(error);
                showAlert(false, "{{ 'a_technical_error_occurred'|translateLocale|mbUcfirst|e('js') }}.");
            })
            .finally(() => {
                hideLoader();
            });
        });
    </script>
{% endblock %}
