<div class="group">
    <div class="form-group" style="--filter-width: 50%;">
        <label class="form-label required" for="name">{{ 'name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="name" id="name"{% if groupGta and groupGta.name %} value="{{ groupGta.name }}"{% endif %} class="form-input" />
        <div class="error" id="error_name">{{ 'please_enter_the_name'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 50%;">
        <label class="form-label" for="description">{{ 'description'|translateLocale|mbUcfirst }}</label>
        <textarea name="description" id="description" class="form-textarea" rows="8">{{ groupGta ? groupGta.description : '' }}</textarea>
        <div class="error" id="error_description">{{ 'please_enter_the_description'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 100%;">
        <label class="form-label" for="default">{{ 'default_group_for_new_accounts'|translateLocale|mbUcfirst }}</label>
        <div class="checkbox-wrapper-2">
            <input type="checkbox" name="default" id="default" value="1"{% if groupGta and groupGta.default %} checked{% endif %} class="stylized" />
        </div>
    </div>
    <input type="hidden" name="id" value="{{ groupGta ? groupGta.id : '' }}" />
</div>
<div class="group">
    <div class="form-group" style="--filter-width: 100%;">
        <label class="form-label">{{ 'permissions'|translateLocale|mbUcfirst }}</label>
        <table class="permissions">
            <thead>
                <tr>
                    <th></th>
                    {% for action in permissions.actions %}
                        <th>{{ ('permission_action_' ~ action|lower)|translateLocale|mbUcfirst }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for bundle, bundleActions in permissions.bundles %}
                    <tr>
                        <th>{{ ('permission_bundle_' ~ bundle|lower)|translateLocale|mbUcfirst }}</th>
                        {% for action in permissions.actions %}
                            <td>
                                {% if bundleActions[action] is defined %}
                                    <div class="checkbox-wrapper-2">
                                        <input type="checkbox" name="permissionIds[]" value="{{ bundleActions[action].id }}" class="stylized"
                                               id="permission_{{ bundleActions[action].id }}"{% if bundleActions[action].active %} checked{% endif %}
                                               aria-label="{{ ('permission_bundle_' ~ bundle|lower)|translateLocale|mbUcfirst }} : {{ ('permission_action_' ~ action|lower)|translateLocale }}" />
                                    </div>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
