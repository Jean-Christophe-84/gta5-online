<div class="group">
    <div class="form-group" style="--filter-width: 50%;">
        <label class="form-label required" for="name">{{ 'name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="name" id="name"{% if titleUpdate and titleUpdate.name %} value="{{ titleUpdate.name }}"{% endif %} class="form-input" />
        <div class="error" id="error_name">{{ 'please_enter_the_name'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 50%;">
        <label class="form-label required" for="releaseDate">{{ 'release_date'|translateLocale|mbUcfirst }}</label>
        <input type="date" name="releaseDate" id="releaseDate"{% if titleUpdate and titleUpdate.releaseDate %} value="{{ titleUpdate.releaseDate|date('Y-m-d') }}"{% endif %} class="form-input" />
        <div class="error" id="error_releaseDate">{{ 'please_enter_the_release_date'|translateLocale|mbUcfirst }} !</div>
    </div>
    <input type="hidden" name="id" value="{{ titleUpdate ? titleUpdate.id : '' }}">
</div>
