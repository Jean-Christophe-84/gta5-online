{% if summary and summary.discounted > 0 %}
    <span class="promotion-badge" aria-label="{{ 'summary_discounted'|translateLocale({entity: entity})|mbUcfirst }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
            <!--!Font Awesome Free v6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.-->
            <path d="M374.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-320 320c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l320-320zM128 128A64 64 0 1 0 0 128a64 64 0 1 0 128 0zM384 384a64 64 0 1 0 -128 0 64 64 0 1 0 128 0z" />
        </svg>
        {{ summary.discounted|formatNumber }}
        <template>
            <div class="tips__title">{{ 'summary_discounted'|translateLocale({entity: entity})|mbUcfirst|colon }} {{ summary.discounted|formatNumber }}</div>
            <ul class="tips__list">
                <li>{{ 'summary_of_which_not_owned'|translateLocale({count: summary.discountedNotOwned, entity: entity})|mbUcfirst }}</li>
                {% if entity != 'weapons' %}
                    <li>{{ 'summary_of_which_wanted'|translateLocale({count: summary.toBuyDiscounted, entity: entity})|mbUcfirst }}</li>
                {% endif %}
            </ul>
        </template>
    </span>
{% endif %}
