<div class="group">
    <div class="form-group" style="--filter-width: 100%;">
        <label class="form-label required" for="name">{{ 'name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="name" id="name" class="form-input"
            {% if vehicleManufacturer %} value="{{ vehicleManufacturer.name }}"{% endif %} />
        <div class="error" id="error_name">{{ 'please_enter_the_name'|translateLocale|mbUcfirst }} !</div>
    </div>
    <div class="form-group" style="--filter-width: 100%;">
        <label class="form-label required" for="realName">{{ 'real_name'|translateLocale|mbUcfirst }}</label>
        <input type="text" name="realName" id="realName" class="form-input"
            {% if vehicleManufacturer and vehicleManufacturer.realName %} value="{{ vehicleManufacturer.realName }}"{% endif %} />
    </div>
    <input type="hidden" name="id" value="{{ vehicleManufacturer ? vehicleManufacturer.id : '' }}">
</div>
